{"nodes": [{"id": "docs_superpowers_plans_2026_09_01_ecs_dynamodb_rps_ceiling_observability_shakedown", "label": "Observability Shakedown Plan (2026-09-01)", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-01-ecs-dynamodb-rps-ceiling-observability-shakedown.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prove every signal exists and moves when the system is deliberately hurt, before money is spent raising capacity; free-tier throttling is a known answer that tests the instruments."}, {"id": "docs_superpowers_plans_2026_09_01_ecs_dynamodb_rps_ceiling_observability_shakedown_attribution_verdict", "label": "Verdict: attribution table said service, truth was database", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-01-ecs-dynamodb-rps-ceiling-observability-shakedown.md", "source_location": "Task 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three independent causes: ThrottledRequests reads 0 mid-throttle, SRL falls under throttling, and SDK retry backoff inflates the queueing gap to 642\u2013938 ms."}, {"id": "docs_superpowers_plans_2026_09_01_ecs_dynamodb_rps_ceiling_observability_shakedown_burst_capacity", "label": "DynamoDB served 2.46\u00d7 provisioned without throttling", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-01-ecs-dynamodb-rps-ceiling-observability-shakedown.md", "source_location": "Task 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provisioned capacity is not a hard wall; 250 rps (not 60) was needed to throttle the 25/25 table."}, {"id": "docs_superpowers_plans_2026_09_01_ecs_dynamodb_rps_ceiling_observability_shakedown_idle_slo_breach", "label": "7-day SLO window in breach at idle", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-01-ecs-dynamodb-rps-ceiling-observability-shakedown.md", "
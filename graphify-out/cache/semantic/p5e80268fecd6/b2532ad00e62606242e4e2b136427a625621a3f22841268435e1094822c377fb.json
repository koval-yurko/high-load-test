{"nodes": [{"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design", "label": "SLI Collection Design Spec (2026-08-30)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design", "label": "Spec: service-emitted SLI collection", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compute the SLO from real service metrics continuously; k6 thresholds demoted to a run gate."}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_alloy_gateway_collector", "label": "S1/S2: single Grafana Alloy gateway collector", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A sidecar would draw from the task's 0.25 vCPU the CPU knob was calibrated against and poll CloudWatch once per task; Alloy's YACE discovery finds resources by the Project tag."}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_native_histograms", "label": "S3/S4: native histograms, no SLO logic in service", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "histogram_fraction applies thresholds at query time, so changing a class threshold is a query edit, not a rebuild."}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_cumulative_temporality", "label": "S6: cumulative temporality pinned", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A collector outage or late export costs resolution, never requests; delta would lose them silently."}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_route_class_mapping", "label": "S8: route\u2192class mapping in the collector", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The service supplies only the route template; the SLO-bearing class mapping stays external, generated from slo.yaml."}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_remote_execution", "label": "S11/S12: TFC remote execution, credentials as workspace variables", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HCP workspace variables are only injected in remote execution mode."}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_slo_window_7d", "label": "S13: SLO window 7d", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "\u00a73, \u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grafana Cloud Free retains 14 days and Grafana's SLO API refuses windows outside 7-32 days, so 7d is the only usable value."}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_burn_rate_scaling", "label": "S14: burn-rate alert windows scale with SLO window", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "14.4x/1h and 6x/6h encode 2% and 5% of a 30-day budget; unscaled against a shorter window they silently consume far more."}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_traffic_source_label", "label": "S16: traffic_source label (k6/synthetic/other)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "\u00a73, \u00a717.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A label not emitted today cannot be applied to yesterday's data; deferring the decision is free, deferring the label forecloses it."}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_alloy_config", "label": "Alloy configuration (OTLP pipeline + CloudWatch pipeline)", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "\u00a716", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two egress paths: OTLP for service histograms, remote_write for already-Prometheus-shaped CloudWatch output, avoiding a lossy conversion."}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_queue_invisibility_hazard", "label": "Hazard: the service cannot see the kernel queue", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "\u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_scanner_404_hazard", "label": "Hazard: scanner 404s on 'unmatched' counted as violations", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "\u00a714", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured at 68% of the population; SLO population is now selected on class so unclassified traffic is excluded."}], "edges": [{"source": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design", "target": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "header: Amends", "weight": 1}, {"source": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design", "target": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d7_k6_sli_source", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "\u00a71, \u00a715", "weight": 1}, {"source": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_native_histograms", "target": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d5_ratio_sli", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "\u00a71, \u00a7
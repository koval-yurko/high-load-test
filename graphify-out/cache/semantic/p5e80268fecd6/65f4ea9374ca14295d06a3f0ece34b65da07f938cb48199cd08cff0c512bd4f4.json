{"nodes": [{"id": "docs_superpowers_specs_2026_09_09_ecs_dynamodb_rps_slo_relaxation_design", "label": "SLO relaxation design spec (95% primary, 99% tail)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-09-ecs-dynamodb-rps-slo-relaxation-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_09_09_ecs_dynamodb_rps_slo_relaxation_design_burn_threshold_formula", "label": "Burn threshold = multiplier \u00d7 (1 \u2212 objective); 93.06% floor", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-09-ecs-dynamodb-rps-slo-relaxation-design.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Miss rate cannot exceed 1, so below 93.06% the 14.4x fast-burn rule can never fire; 85% was rejected for this."}, {"id": "docs_superpowers_specs_2026_09_09_ecs_dynamodb_rps_slo_relaxation_design_r1_primary_95", "label": "R1: primary latency objective 99% \u2192 95%", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-09-ecs-dynamodb-rps-slo-relaxation-design.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five times the budget: idle 166% \u2192 33%, clean constant run 67% \u2192 13%, so a burn is legible; both burn rules stay firable."}, {"id": "docs_superpowers_specs_2026_09_09_ecs_dynamodb_rps_slo_relaxation_design_r2_tail_99", "label": "R2: tail objective 99.9% \u2192 99%", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-09-ecs-dynamodb-rps-slo-relaxation-design.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moves the early warning to the tail rule (14.4% / 6%), where the primary rule sat before."}, {"id": "docs_superpowers_specs_2026_09_09_ecs_dynamodb_rps_slo_relaxation_design_r3_thresholds_unchanged", "label": "R3: class thresholds unchanged (50/200/800 ms)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-09-ecs-dynamodb-rps-slo-relaxation-design.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Achievable (fast p99 15.38 ms warm) and they size k6 preAllocatedVUs; loosening against a 100-VU cap cuts deliverable rps."}, {"id": "docs_superpowers_specs_2026_09_09_ecs_dynamodb_rps_slo_relaxation_design_r5_floor_test", "label": "R5: firability floor enforced by generate-slo.test.js", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-09-ecs-dynamodb-rps-slo-relaxation-design.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "docs_superpowers_specs_2026_09_09_ecs_dynamodb_rps_slo_relaxation_design", "target": "docs_superpowers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_slo_scope_design", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-09-ecs-dynamodb-rps-slo-relaxation-design.md", "source_location": "Amends", "weight": 1}, {"source": "docs_superpowers_specs_2026_09_09_ecs_dynamodb_rps_slo_relaxation_design_r1_primary_95", "target": "docs_superpowers_specs_2026_09_09_ecs_dynamodb_rps_slo_relaxation_design_burn_threshold_formula", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-09-ecs-dynamodb-rps-slo-relaxation-design.md", "source_location": "\u00a73", "weight": 1}, {"source": "docs_superpowers_specs_2026_09_09_ecs_dynamodb_rps_slo_relaxation_design_r2_tail_99", "target": "docs_superpowers_specs_2026_09_09_ecs_dynamodb_rps_slo_relaxation_design_r1_primary_95", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_
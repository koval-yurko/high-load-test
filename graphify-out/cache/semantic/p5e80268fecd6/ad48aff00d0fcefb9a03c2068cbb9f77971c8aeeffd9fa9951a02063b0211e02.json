{"nodes": [{"id": "docs_superpowers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_datasource_fidelity_design", "label": "Datasource Fidelity Design Spec (2026-09-01)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-01-ecs-dynamodb-rps-ceiling-datasource-fidelity-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_datasource_fidelity_design", "label": "Datasource fidelity design spec (dashboard keeps CloudWatch)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-01-ecs-dynamodb-rps-ceiling-datasource-fidelity-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upholds the decision not to migrate CloudWatch panels to the Alloy-forwarded copy, with measured evidence."}, {"id": "docs_superpowers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_datasource_fidelity_design_readthrottle_peak_measurement", "label": "ReadThrottleEvents peak 5588 vs forwarded 4360 (21% understatement)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-ecs-dynamodb-rps-ceiling-datasource-fidelity-design.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_datasource_fidelity_design_alloy_window_behaviours", "label": "Alloy 300s-window behaviours: 2-min lag, bucket misalignment, stale hold", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-ecs-dynamodb-rps-ceiling-datasource-fidelity-design.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alloy v1.10.0 does not expose YACE's delay, so length is 5x period; structural, not a tuning error."}, {"id": "docs_superpowers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_datasource_fidelity_design_queueing_panel", "label": "queueing_ms_by_route panel (DB wall-clock minus SuccessfulRequestLatency)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-ecs-dynamodb-rps-ceiling-datasource-fidelity-design.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-minute skew bounded at ~1% error against 642\u2013938 ms queueing; lagging the service histogram would trade 1% error for a blind spot."}, {"id": "docs_superpowers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_datasource_fidelity_design_d1_keep_cloudwatch", "label": "D1: dashboard keeps CloudWatch datasource for all 22 AWS targets", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-ecs-dynamodb-rps-ceiling-datasource-fidelity-design.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forwarded copy understates the headline peak by 21%; Grafana is already the single pane."}, {"id": "docs_superpowers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_datasource_fidelity_design_d2_forwarded_copy_stays", "label": "D2: forwarded copy stays, unread by panels", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-ecs-dynamodb-rps-ceiling-datasource-fidelity-design.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needed for the queueing join and PromQL burn rules; ALB/ECS halves later removed (read by nothing), DynamoDB block later trimmed to SuccessfulRequestLatency."}, {"id": "docs_superpowers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_datasource_fidelity_design_d3_max_without_instance", "label": "D3: max without (instance) instead of sum over aws_* series", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-ecs-dynamodb-rps-ceiling-datasource-fidelity-design.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "During a collector redeploy overlapping instance series make every sum() read double; max is correct with one or two instances."}, {"id": "docs_superpowers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_datasource_fidelity_design_d5_datasource_uid_templating", "label": "D5: dashboard takes datasource UIDs via templatefile", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-ecs-dynamodb-rps-ceiling-datasource-fidelity-design.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hardcoded uid breaks the dashboard silently if the stack is rebuilt."}], "edges": [{"source": "docs_superpowers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_datasource_fidelity_design_d1_keep_cloudwatch", "target": "docs_superpowers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_datasource_fidelity_design_readthrottle_peak_measurement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-01-ecs-dynamodb-rps-ceiling-datasource-fidelity-design.md", "source_location": "\u00a75", "weight": 1}, {"source": "docs_superpowers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_datasource_fidelity_design_readthrottle_peak_measurement", "target": "docs_superpowers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_datasource_fidelity_design_alloy_window_behaviours", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-01-ecs-dynamodb-rps-ceiling-datasource-fidelity-design.md", "source_location": "\u00a73", "weight": 1}, {"source": "docs_superpowers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_datasource_fidelity_design_d2_forwarded_copy_stays", "target": "docs_superpowers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_datasource_fidelity_design_queueing_panel"
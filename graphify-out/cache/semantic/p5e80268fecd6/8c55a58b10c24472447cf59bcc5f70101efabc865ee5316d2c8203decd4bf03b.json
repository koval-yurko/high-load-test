{"nodes": [{"id": "docs_superpowers_plans_2026_09_21_ecs_rds_postgres_pool_infrastructure", "label": "Plan 2: ecs-rds-postgres-pool infrastructure", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-21-ecs-rds-postgres-pool-infrastructure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_plans_2026_09_21_ecs_rds_postgres_pool_infrastructure_d1_canary", "label": "D1 fork canary.tf (SLI-absent alert)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-21-ecs-rds-postgres-pool-infrastructure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spec wrongly called it orthogonal; the live resource alerts when the SLI series goes absent, guarding against empty-panel-looks-healthy."}, {"id": "docs_superpowers_plans_2026_09_21_ecs_rds_postgres_pool_infrastructure_d2_deferred_generated", "label": "D2 threshold-dependent generated files deferred to plan 3", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-21-ecs-rds-postgres-pool-infrastructure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "locals.tf, alerts.tf, slo.tf and k6 slo.js bake thresholds, which are null until calibration; dashboard SLI panel id preserved so alert links hold."}, {"id": "docs_superpowers_plans_2026_09_21_ecs_rds_postgres_pool_infrastructure_d3_drop_cloudwatch_pipeline", "label": "D3 drop collector CloudWatch pipeline and dependents", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-21-ecs-rds-postgres-pool-infrastructure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_plans_2026_09_21_ecs_rds_postgres_pool_infrastructure_d4_rds_ca_bundle", "label": "D4 trust system roots plus RDS CA bundle", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-21-ecs-rds-postgres-pool-infrastructure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ca replaces default trust store; instance needs RDS CA and proxy needs public roots, so trust both with rejectUnauthorized true."}, {"id": "docs_superpowers_plans_2026_09_21_ecs_rds_postgres_pool_infrastructure", "label": "Plan 2: ecs-rds-postgres-pool infrastructure", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-21-ecs-rds-postgres-pool-infrastructure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "plan2_rds_tf", "label": "rds.tf (RDS instance with teardown guards)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-21-ecs-rds-postgres-pool-infrastructure.md", "source_location": "Task 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "db.t4g.micro is deliberate: its ~112 connection ceiling is what knob 2 aims at; a larger class would raise the ceiling and remove the proxy phase's point. Teardown survivor guards (skip_final_snapshot, no backups, explicit log group) keep destroy clean."}, {"id": "plan2_proxy_tf", "label": "proxy.tf (count-gated RDS Proxy and host switch)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-21-ecs-rds-postgres-pool-infrastructure.md", "source_location": "Task 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Count-gated so it costs nothing until proxy_enabled flips; local.db_host switches the service target with no code change, rebuild or redeploy. Secrets Manager recovery_window_in_days=0 avoids collision with scheduled-for-deletion secrets."}, {"id": "plan2_ecs_tf", "label": "ecs.tf / collector.tf (service and OTLP collector)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-21-ecs-rds-postgres-pool-infrastructure.md", "source_location": "Task 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pipeline 2 (CloudWatch exporter) dropped because Postgres publishes no per-operation server-side latency to subtract; desired_count kept Terraform-owned for deterministic runs."}, {"id": "plan2_saturation_tf", "label": "saturation.tf (database and proxy saturation rules)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-21-ecs-rds-postgres-pool-infrastructure.md", "source_location": "Task 11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One rule per metric with no_data_state=OK because CloudWatch publishes sparsely; credit rule watches CPUSurplusCreditBalance because unlimited-mode instances do not throttle on an empty balance."}, {"id": "plan2_canary_tf", "label": "canary.tf (SLI-absent rule)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-21-ecs-rds-postgres-pool-infrastructure.md", "source_location": "Task 12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An empty panel and a healthy system look identical; a run with no data mistaken for good numbers is the worst outcome."}, {"id": "plan2_heartbeat", "label": "heartbeat Lambda", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-21-ecs-rds-postgres-pool-infrastructure.md", "source_location": "Task 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "plan2_pool_js_buildssl", "label": "pool.js buildSsl (certificate verification)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-21-ecs-rds-postgres-pool-infrastructure.md", "source_location": "Task 15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trusts RDS CA bundle AND Node public roots because passing ca replaces the default store; knob 3's proxy presents an ACM chain to public roots."}, {"id": "plan2_k6_module", "label": "k6 module and load profiles", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-21-ecs-rds-postgres-pool-infrastructure.md", "source_location": "Task 13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "plan2_knob_sequence", "label": "Knob sequence (pool_size, desired_count, proxy_enabled)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-21-ecs-rds-postgres-pool-infrastructure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "plan2_ruling_r19", "label": "R19: open DB security group with password from root .env", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-21-ecs-rds-postgres-pool-infrastructure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen for psql from any network with nothing personal to maintain, and to keep every secret at the root; reverses R16 and supersedes R12."}, {"id": "plan2_ruling_r20", "label": "R20: posts table not reset; size recorded", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-21-ecs-rds-postgres-pool-infrastructure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "20% of the mix plus the heartbeat insert rows, so the table grows; recording SELECT count(*) per row replaces building a reset."}], "edges": [{"source": "docs_superpowers_plans_2026_09_21_ecs_rds_postgres_pool_infrastructure", "target": "docs_superpowers_plans_2026_09_20_ecs_rds_postgres_pool_service", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-09-21-ecs-rds-postgres-pool-infras
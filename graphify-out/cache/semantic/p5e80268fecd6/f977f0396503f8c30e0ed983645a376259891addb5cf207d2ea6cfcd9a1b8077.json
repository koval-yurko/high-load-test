{"nodes": [{"id": "docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response", "label": "Plan: ecs-dynamodb-rps spike response from a floor of one task", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-15-ecs-dynamodb-rps-spike-response.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goal: from a floor of one task, answer a short spike without changing k6 load profiles; measured by first scaling action timing/size and SLO attainment."}, {"id": "docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response_gating_ruling", "label": "Gating ruling: one Terraform flag per change", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-15-ecs-dynamodb-rps-spike-response.md", "source_location": "Execution record", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Change one thing, identical profile' requires baseline and every re-measure to run from the same commit, so each change sits behind its own flag (requests_scaling_enabled, elu_scaling_enabled, shedding_enabled) and each re-measure flips exactly one."}, {"id": "docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response_min_capacity_equals_desired_count", "label": "min_capacity = var.desired_count (autoscaling_min deleted)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-15-ecs-dynamodb-rps-spike-response.md", "source_location": "Task 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One number governs the floor and the Terraform baseline so they cannot drift; a second number is what caused run 8554820."}, {"id": "docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response_requests_scaling_policy", "label": "Change 1: ALBRequestCountPerTarget scaling policy (target 6000/min)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-15-ecs-dynamodb-rps-spike-response.md", "source_location": "Task 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added as a second policy rather than editing the CPU one: Application Auto Scaling takes the largest desired count, and CPU covers individually expensive requests like /reports. 6000/min = 100 rps/task, the conservative end of the 100-200 rps bracket from run 8554820."}, {"id": "docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response_elu_publisher", "label": "ELU sampler + CloudWatch PutMetricData publisher (elu.js, cloudwatch.js)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-15-ecs-dynamodb-rps-spike-response.md", "source_location": "Task 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High-resolution PutMetricData, not EMF-through-logs, because log ingestion delay lands on the exact number this change exists to shrink; dimensioned by service so tasks aggregate under one alarm; failures swallowed so a metrics outage cannot take the service down."}, {"id": "docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response_elu_step_scaling", "label": "Change 2: ELU 20s alarm (0.70) + PercentChangeInCapacity step policy", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-15-ecs-dynamodb-rps-spike-response.md", "source_location": "Task 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An alarm with an Auto Scaling action re-invokes at most once per minute, so 20-second detection buys a fast first decision, not a fast repeating one \u2014 hence large steps (+200%, +400%)."}, {"id": "docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response_admission_control", "label": "Change 3: admission gate (429 + Retry-After at ELU > 0.92)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-15-ecs-dynamodb-rps-spike-response.md", "source_location": "Task 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs after matchRoute so shed 429s keep their route label in SLO metrics instead of collapsing into 'unmatched'; still before body reading and DB work (~1 ms). /healthz never shed so the ALB is not told a busy task is unhealthy."}, {"id": "docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response_shed_threshold_invariant", "label": "Invariant: scale-out thresholds (0.70, 0.85) < shed threshold (0.92)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-15-ecs-dynamodb-rps-spike-response.md", "source_location": "Task 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shedding lowers ELU, so a shed threshold at or below the scale-out steps clamps the metric under the alarm and the service sheds forever on one task while looking healthy; asserted in a unit test reading the configured values."}, {"id": "docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response_shedding_silences_scaler_risk", "label": "Risk: on/off shedding averages ELU below 0.70 alarm", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-15-ecs-dynamodb-rps-spike-response.md", "source_location": "Task 10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All-or-nothing gate with no hysteresis over a 250 ms window, published as a 10 s average, can oscillate below the alarm threshold while shedding; the request-count policy is kept on as second line of defence because it counts arrivals including rejected ones."}, {"id": "docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response_4xx_divergence", "label": "4xx divergence: k6 slo_met counts 429 as a miss", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-15-ecs-dynamodb-rps-spike-response.md", "source_location": "Task 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Once admission control is live a correct shedding run exits 99 with slo_met and http_req_failed breached; SLO attainment for those runs is read from Grafana, whose GOOD selector (!~\"5..\") counts a 429 as good."}, {"id": "docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response_task3_k6_409_conflict", "label": "Task 3 failure: k6 project 409 Conflict (8476029 still in platform state)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-15-ecs-dynamodb-rps-spike-response.md", "source_location": "Execution record, Task 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response_platform_state_rm", "label": "terraform state rm of stale k6 project from platform (2026-09-18)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-15-ecs-dynamodb-rps-spike-response.md", "source_location": "Execution record, Task 3 first step", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 404 occurred during refresh, blocking the plan itself, so apply could never reach the destroy; state rm was the approved fallback."}, {"id": "docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response_stress_profile", "label": "stress.js load profile (RATE=100, peak 300 rps)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-15-ecs-dynamodb-rps-spike-response.md", "source_location": "Task 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identical profile and RATE across baseline and every re-measure; only infrastructure changes."}], "edges": [{"source": "docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response_gating_ruling", "target": "docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response_requests_scaling_policy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "s
ers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_attribution_simplified_design_misattribution_incident", "relation": "conceptually_related_to", "confidence": "AMBIGUOUS", "confidence_score": 0.4, "source_file": "docs/superpowers/plans/2026-09-15-ecs-dynamodb-rps-spike-response.md", "source_location": "Task 7", "weight": 1}], "hyperedges": [{"id": "spike_response_flag_gated_changes", "label": "Spike-response changes 1-3 gated one flag per re-measure", "nodes": ["docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response_gating_ruling", "docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response_requests_scaling_policy", "docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response_elu_step_scaling", "docs_superpowers_plans_2026_09_15_ecs_dynamodb_rps_spike_response_admission_control"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "docs/superpowers/plans/2026-09-15-ecs-dynamodb-rps-spike-response.md"}]}
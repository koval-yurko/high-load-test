{"nodes": [{"id": "docs_superpowers_plans_2026_09_01_ecs_dynamodb_rps_ceiling_attribution_simplified", "label": "Simplified Attribution Implementation Plan (2026-09-01)", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-01-ecs-dynamodb-rps-ceiling-attribution-simplified.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delete the four-row model that misattributed DynamoDB throttling to the service; replace with two metrics read side by side by a human."}, {"id": "docs_superpowers_plans_2026_09_01_ecs_dynamodb_rps_ceiling_attribution_simplified_two_metrics", "label": "Two metrics, no verdict: latency + throttle events", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-01-ecs-dynamodb-rps-ceiling-attribution-simplified.md", "source_location": "Global Constraint 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SDK retry backoff inside Node inflates every service-side signal under throttling, so nothing should compute a bound resource."}, {"id": "docs_superpowers_plans_2026_09_01_ecs_dynamodb_rps_ceiling_attribution_simplified_throttle_events", "label": "ReadThrottleEvents / WriteThrottleEvents replace ThrottledRequests", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-01-ecs-dynamodb-rps-ceiling-attribution-simplified.md", "source_location": "Task 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ThrottledRequests is published only with a TableName+Operation dimension pair and reads 0 at instants during sustained throttling; the event metrics are table-level, continuous and read/write-separated."}, {"id": "docs_superpowers_plans_2026_09_01_ecs_dynamodb_rps_ceiling_attribution_simplified_no_rate_on_gauges", "label": "Never rate() CloudWatch per-60s gauges", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-01-ecs-dynamodb-rps-ceiling-attribution-simplified.md", "source_location": "Global Constraint 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rate() treats every decrease of a per-period sum gauge as a counter reset."}, {"id": "docs_superpowers_plans_2026_09_01_ecs_dynamodb_rps_ceiling_attribution_simplified_srl_falls_trap", "label": "SuccessfulRequestLatency falls under throttling", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-01-ecs-dynamodb-rps-ceiling-attribution-simplified.md", "source_location": "Task 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected requests never enter the statistic (0.887 ms mid-throttle vs 1.473 ms idle), so a flat DynamoDB clock is not evidence of health."}, {"id": "docs_superpowers_plans_2026_09_01_ecs_dynamodb_rps_ceiling_attribution_simplified_results_schema", "label": "Fourteen-column results.md schema and awk completeness check", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-01-ecs-dynamodb-rps-ceiling-attribution-simplified.md", "source_location": "Task 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drops bound resource, evidence and queueing ms; indices ($4,$6,$7,$13) are proven by piping the header through awk, not counted, because the old check never validated service attainment."}], "edges": [{"source": "docs_superpowers_plans_2026_09_01_ecs_dynamodb_rps_ceiling_attribution_simplified", "target": "docs_superpowers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_attribution_simplified_design", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-09-01-ecs-dynamodb-rps-ceiling-attribution-simplified.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_plans_2026_09_01_ecs_dynamodb_rps_ceiling_attribution_simplified", "target": "docs_superpowers_plans_2026_08_31_ecs_
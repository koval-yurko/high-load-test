{"nodes": [{"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design", "label": "Design spec (2026-09-19)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md"}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_s1", "label": "Spec decision S1: per-request pool-wait attribution", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "rationale": "Own the pg.Pool via @prisma/adapter-pg and carry checkout time via AsyncLocalStorage, since Prisma's built-in metrics feature was removed in 7.0.0."}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_s2", "label": "Spec decision S2: knob sequence -- pool, then tasks, then proxy", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "rationale": "RDS Proxy pools connections behind the application, so a proxy run against a small pool measures the same queue twice; the proxy only earns its keep once client connections would otherwise exceed the instance ceiling."}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_s3", "label": "Spec decision S3: observability forked, admission control and autoscaling not", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "rationale": "Admission control sheds 429 while this design wants a saturated pool to fail as 5xx (burning availability budget), so forking admission.js would collide with the SLI's treatment of overload."}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_s4", "label": "Spec decision S4: db.t4g.micro with credit balance as a run gate", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "rationale": "Credit mode cannot be set from Terraform (no credit_specification attribute on aws_db_instance), so unlimited-mode burst spend is handled procedurally: a run does not start until the balance is full, and a run that depletes it is disqualified."}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_section3_1", "label": "Spec \u00a73.1: Prisma metrics feature removed", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md"}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_section3_2", "label": "Spec \u00a73.2: driver adapter accepts an app-owned pool", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md"}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_section3_3", "label": "Spec \u00a73.3: Performance Insights available on db.t4g.micro for Postgres", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md"}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_section3_4", "label": "Spec \u00a73.4: T-class credit mode not settable from Terraform", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md"}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_section4_2", "label": "Spec \u00a74.2: per-request pool wait metric (db.pool.wait.duration)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md"}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_section4_3", "label": "Spec \u00a74.3: what gets forked from the sibling, deliberately-not-forked table", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md"}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_section5", "label": "Spec \u00a75: Calibration -- making the pool bind first", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md"}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_section6", "label": "Spec \u00a76: The knob sequence", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md"}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_section7_2", "label": "Spec \u00a77.2: instance class and the credit gate", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md"}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_section7_3", "label": "Spec \u00a77.3: reaching the database", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md"}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_section8", "label": "Spec \u00a78: SLO and alerting", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md"}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_section11", "label": "Spec \u00a711: Target structure tree", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md"}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design", "label": "Spec: ecs-rds-postgres-pool design (2026-09-19)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design", "target": "docs_research_ecs_rds_postgres_pool", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "weight": 1}, {"source": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_d
{"nodes": [{"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design", "label": "Spec: ecs-rds-postgres-pool design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "spec_s1_per_request_pool_wait", "label": "S1: per-request pool wait attribution", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "section 4.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A global histogram can say a queue existed but not whose requests were in it; the per-class SLI needs per-request attribution via AsyncLocalStorage."}, {"id": "spec_s2_knob_sequence", "label": "S2: three knobs, scale to four tasks then proxy", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "section 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RDS Proxy pools behind the app's own pool, so against pool 5 it measures the same queue twice; it only matters when client connections would exceed instance capacity (~100 of ~112)."}, {"id": "spec_s3_fork_observability_only", "label": "S3: fork observability, not admission control or autoscaling", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "section 4.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admission control sheds 429 (not an SLI miss) while this design wants a saturated pool to produce 5xx; one ledger cannot measure both."}, {"id": "spec_s4_burstable_credit_gate", "label": "S4: stay on db.t4g.micro with credit balance as run gate", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "section 7.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Credit mode cannot be set from Terraform; a non-burstable class raises cost and max_connections, moving the cliff knob 2 aims at."}, {"id": "spec_calibration_section5", "label": "Calibration: making the pool bind first", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If pool and database saturate together no slow request can be attributed to either; target is a relationship (pool binds while DB has CPU headroom), not a number."}, {"id": "spec_three_queues", "label": "Three queues in series measurement model", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "section 4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "spec_prisma_metrics_removed", "label": "Prisma metrics removed in 7.0.0", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "section 3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forced S1: the built-in wait histogram no longer exists, so the service owns the pg.Pool via the driver adapter."}, {"id": "spec_performance_insights_micro", "label": "Performance Insights available on db.t4g.micro for Postgres", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "section 3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "spec_pool_wait_metric", "label": "db.pool.wait.duration metric", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "section 4.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renamed from pool.duration to sit coherently beside db.pool.waiting/idle/total gauges."}, {"id": "spec_slo_yaml", "label": "slo.yaml", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "section 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "spec_execution_shape", "label": "Four-plan execution shape", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "section 12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan 4 must contain no implementation, so every knob ships as inert code in earlier plans and release is a one-line dev.tfvars edit."}, {"id": "spec_secrets_manager_proxy", "label": "RDS Proxy requires Secrets Manager", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "section 7.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "spec_s1_per_request_pool_wait", "target": "spec_prisma_metrics_removed", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "section 3.1", "weight": 1}, {"source": "spec_s1_per_request_pool_wait", "target": "spec_pool_wait_metric", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "section 4.2", "weight": 1}, {"source": "spec_three_queues", "target": "spec_s1_per_request_pool_wait", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "section 4.1", "weight": 1}, {"source": "spec_s4_burstable_credit_gate", "target": "spec_performance_insights_micro", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.7, "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": null, "weight": 1}, {"source": "spec_s2_knob_sequence", "target": "spec_secrets_manager_proxy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.8, "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "section 7.4", "weight": 1}, {"source": "spec_execution_shape", "target": "spec_s2_knob_sequence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "section 12", "weight": 1}], "hyperedges": [{"id": "three_knob_release_sequence", "label": "Three-knob release sequence", "nodes": ["plan2_knob_sequence", "plan2_proxy_tf", "spec_s2_knob_sequence", "spec_secrets_manager_proxy"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md"}]}
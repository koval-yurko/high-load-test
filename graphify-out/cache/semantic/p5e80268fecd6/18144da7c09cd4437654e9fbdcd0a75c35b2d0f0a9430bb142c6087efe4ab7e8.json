{"nodes": [{"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design", "label": "ecs-rds-postgres-pool design spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_s1_per_request_pool_wait", "label": "S1: per-request pool wait via AsyncLocalStorage", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "Section 4.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SLI is per-class so a global histogram cannot say whose requests were queued; Prisma metrics were removed in 7.0.0."}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_s2_knob_sequence", "label": "S2: three-knob sequence (pool 25, 4 tasks, proxy)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "Section 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RDS Proxy pools behind the app and does not remove its own pool; the proxy only matters when client connections would exceed ~112, so knob 2 (100 of ~112) makes knob 3 meaningful."}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_s3_fork_observability_only", "label": "S3: fork observability, not control loops", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "Section 4.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admission control sheds 429 (not an SLO miss) while this design wants saturation to produce 5xx; one ledger cannot measure both treatments."}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_s4_burstable_credit_gate", "label": "S4: db.t4g.micro with credit balance as run gate", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "Section 7.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "credit_specification does not exist on aws_db_instance in provider 6.62.0, so credit mode cannot be set from Terraform; a non-burstable class would raise cost and move max_connections."}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_calibration", "label": "Section 5 calibration: make the pool bind first", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "Section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If pool and database saturate together, no slow request can be attributed to either; the target is a relationship (database CPU headroom while pool binds)."}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_three_queues", "label": "Three queues in series (event loop, pool, Postgres)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "Section 4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_performance_insights", "label": "Performance Insights on db.t4g.micro PostgreSQL", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "Section 3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The micro-instance exclusion applies to MySQL/MariaDB only; PostgreSQL has no restriction."}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_teardown_survivors", "label": "Teardown survivors table", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "Section 7.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_execution_shape", "label": "Four-plan execution shape", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "Section 12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every knob ships as inert code in earlier plans so plan 4 is only a tfvars edit, apply and re-run."}, {"id": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_saturation_tf", "label": "saturation.tf (replaces throttles.tf)", "file_type": "code", "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "Section 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_s1_per_request_pool_wait", "target": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_three_queues", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "Section 4", "weight": 1}, {"source": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_calibration", "target": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_s2_knob_sequence", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "Section 5-6", "weight": 1}, {"source": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_saturation_tf", "target": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_performance_insights", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.8, "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "Section 8", "weight": 1}, {"source": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design", "target": "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_execution_shape", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md", "source_location": "Section 12", "weight": 1}], "hyperedges": [{"id": "knob_sequence_flow", "label": "Pool release knob sequence", "nodes": ["docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_s2_knob_sequence", "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_calibration", "docs_superpowers_specs_2026_09_19_ecs_rds_postgres_pool_design_execution_shape"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.8, "source_file": "docs/superpowers/specs/2026-09-19-ecs-rds-postgres-pool-design.md"}]}
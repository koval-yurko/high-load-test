{"nodes": [{"id": "ecs_rds_postgres_pool_readme", "label": "ecs-rds-postgres-pool README", "file_type": "document", "source_file": "ecs-rds-postgres-pool/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "ecs_rds_postgres_pool_project", "label": "ecs-rds-postgres-pool project (connection pool bottleneck scenario)", "file_type": "concept", "source_file": "ecs-rds-postgres-pool/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built so the application connection pool is the binding constraint, then released one knob at a time"}, {"id": "ecs_rds_postgres_pool_knob_sequence", "label": "Knob sequence (pool size, tasks, RDS Proxy)", "file_type": "concept", "source_file": "ecs-rds-postgres-pool/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One change per apply and per ledger row so each fix is measured with the identical k6 profile"}, {"id": "ecs_rds_postgres_pool_knob1_pool_size", "label": "Knob 1: pool_size = 25", "file_type": "concept", "source_file": "ecs-rds-postgres-pool/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "ecs_rds_postgres_pool_knob2_desired_count", "label": "Knob 2: desired_count = 4", "file_type": "concept", "source_file": "ecs-rds-postgres-pool/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "25x4=100 connections against estimated ~112 ceiling makes 'too many clients' 5xx reachable"}, {"id": "ecs_rds_postgres_pool_knob3_rds_proxy", "label": "Knob 3: RDS Proxy (proxy_enabled)", "file_type": "concept", "source_file": "ecs-rds-postgres-pool/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run last and destroy promptly: costs ~40% of idle bill with possibly zero measured benefit"}, {"id": "ecs_rds_postgres_pool_dbload_caveat", "label": "DBLoadRelativeToNumVCPUs caveat", "file_type": "concept", "source_file": "ecs-rds-postgres-pool/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg_sleep sessions count as active in Performance Insights, so metric reads about pool_size/vCPUs; use DBLoadCPU/vCPUs for real CPU share"}, {"id": "ecs_rds_postgres_pool_saturation_alerts", "label": "Database saturation alert rules", "file_type": "concept", "source_file": "ecs-rds-postgres-pool/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One rule per CloudWatch metric, no math expressions, since sparse metrics would go NO DATA during incidents"}, {"id": "ecs_rds_postgres_pool_burn_rate_alerts", "label": "Burn-rate and SLI-absent alerts", "file_type": "concept", "source_file": "ecs-rds-postgres-pool/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SLI-absent separates quiet from blind since burn rules treat no data as OK"}, {"id": "ecs_rds_postgres_pool_env_contract", "label": "Environment-variable contract (service vs task definition)", "file_type": "concept", "source_file": "ecs-rds-postgres-pool/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A misspelt name silently falls back to default, so changes must be made in both files; no SHED_ELU_THRESHOLD so saturated pool produces 5xx"}, {"id": "ecs_rds_postgres_pool_k6_profiles", "label": "k6 profiles: discovery, constant, stress", "file_type": "concept", "source_file": "ecs-rds-postgres-pool/README.md", "source_location": null, "source_url": null, "captured_at": null, "autho
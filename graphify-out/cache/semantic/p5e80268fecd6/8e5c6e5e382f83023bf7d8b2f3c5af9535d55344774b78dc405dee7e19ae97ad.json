{"nodes": [{"id": "docs_research_ecs_rds_postgres_pool", "label": "Research: ecs-rds-postgres-pool", "file_type": "document", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_research_ecs_rds_postgres_pool_dbloadrelativetonumvcpus", "label": "DBLoadRelativeToNumVCPUs (Performance Insights)", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Postgres's analogue to DynamoDB ThrottledRequests: above 1.0 means more runnable sessions than vCPUs, read live from CloudWatch AWS/RDS with no agent and free 7-day retention"}, {"id": "docs_research_ecs_rds_postgres_pool_three_queues", "label": "Three queues in series (event loop, pool checkout, Postgres backend)", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_research_ecs_rds_postgres_pool_c1_pool_binding", "label": "C1: make the pool the binding constraint (hold-time calibration)", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "By Little's law a pool of 5 with 2 ms queries serves 2,500 qps, far above what 100 VUs can generate; hold time must be ~20 ms so pool 5 binds at ~250 rps while DBLoad/vCPU \u2248 0.5"}, {"id": "docs_research_ecs_rds_postgres_pool_prisma", "label": "Prisma as the pool owner", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen on review over raw pg; removes the connection-leak bug class and bespoke migrations (prisma migrate deploy takes an advisory lock), but leaves no checkout call to wrap"}, {"id": "docs_research_ecs_rds_postgres_pool_prisma_wait_histogram", "label": "prisma_client_queries_wait_histogram_ms", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ready-made pool-wait distribution behind previewFeatures=[\"metrics\"], but process-global, not per class"}, {"id": "docs_research_ecs_rds_postgres_pool_d7_pool_wait_source", "label": "D7: where the pool-wait number comes from", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Open decision: (a) @prisma/adapter-pg + AsyncLocalStorage for per-class attribution, (b) Alloy scrape of prisma.$metrics.prometheus(), or (c) both"}, {"id": "docs_research_ecs_rds_postgres_pool_d5_second_knob", "label": "D5: what the second knob is", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Open: neither pool_size nor RDS Proxy is database scaling; options are proxy vs winning pool, proxy vs pool 5, or instance class + max_connections"}, {"id": "docs_research_ecs_rds_postgres_pool_rds_proxy", "label": "RDS Proxy (proxy_enabled knob)", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moves the wait out of the process; expected result against 1-4 long-lived ECS tasks is +1-2 ms p95 and +$0.03/hr for no gain, so the expectation is pre-registered"}, {"id": "docs_research_ecs_rds_postgres_pool_session_pinning", "label": "DatabaseConnectionsCurrentlySessionPinned", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pinning silently turns the proxy into a passthrough, so it needs a panel and alert"}, {"id": "docs_research_ecs_rds_postgres_pool_max_connections_cliff", "label": "C5: max_connections cliff (db.t4g.micro = 112)", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Past the limit Postgres returns FATAL too many clients (5xx), burning availability not latency; so autoscaling stays off during the pool comparison"}, {"id": "docs_research_ecs_rds_postgres_pool_t_class_credits", "label": "C6: T-class CPU credits break comparability", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "aws_db_instance may have no credit_specification; record CPUCreditBalance per run; replaces the DynamoDB 6-minute drain ritual"}, {"id": "docs_research_ecs_rds_postgres_pool_teardown_survivors", "label": "C10: RDS teardown survivors", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "skip_final_snapshot, backup_retention_period=0, explicit log group, Secrets Manager recovery_window_in_days=0 because destroy/re-apply collides with scheduled deletion"}, {"id": "docs_research_ecs_rds_postgres_pool_phases", "label": "Eight phases (spec \u2192 code \u2192 plan \u2192 apply/calibrate \u2192 baseline \u2192 pool 25 \u2192 proxy \u2192 teardown)", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Revised from ten to eight: no local test runs, calibration on the deployed instance, both knobs pre-wired as count-gated Terraform variables"}, {"id": "docs_research_ecs_rds_postgres_pool_d1_sli_unchanged", "label": "D1: SLI unchanged \u2014 pool wait is evidence, not an objective", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pool wait is a cause, not a user-felt symptom; handled like throttles in the sibling (dashboard row + alerts)"}, {"id": "docs_research_ecs_rds_postgres_pool_alloy_pipeline_2_removal", "label": "Alloy stays; CloudWatch pipeline 2 goes", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pipeline 2 existed only to subtract SuccessfulRequestLatency; Postgres has no equivalent, and the OTLP gateway pipeline is needed for the class label"}], "edges": [{"source": "docs_research_ecs_rds_postgres_pool", "target": "docs_research_ecs_rds_postgres_pool_dbloadrelativetonumvcpus", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "weight": 1}, {"source": "docs_research_ecs_rds_postgres_pool", "target": "docs_research_ecs_rds_postgres_pool_three_queues", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "weight": 1}, {"source": "docs_research_ecs_rds_postgres_pool", "target": "docs_research_ecs_rds_postgres_pool_c1_pool_binding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_fi
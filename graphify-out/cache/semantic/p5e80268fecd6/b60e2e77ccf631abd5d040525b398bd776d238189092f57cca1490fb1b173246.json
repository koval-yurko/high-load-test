{"nodes": [{"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify", "label": "Plan: graffiti \u2192 graphify", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replace graffiti with graphify, committing only the LLM-extracted semantic cache because it is the one artifact that costs LLM calls to recreate."}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_gate1_terraform_coverage", "label": "Gate 1: graphify sees Terraform and beats graffiti", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": "Task 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without the [terraform] extra, 33 of 81 code files contribute nothing and the failure is only a warning; passed with 17 Terraform nodes vs graffiti's 0."}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_gitignore_nested_reinclusion", "label": ".gitignore nested re-inclusion of graphify-out/cache/semantic/", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": "Task 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "git does not descend into an excluded directory, so 'graphify-out/' plus a negation re-includes nothing and fails silently."}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_gate2_semantic_cache_replay", "label": "Gate 2: committed semantic cache replays for free, byte-stable", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": "Task 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Byte stability (no timestamps in cache.py) is what makes git diff --cached --quiet an exact empty-commit guard."}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_read_guard_wrapper", "label": ".claude/hooks/graphify-read-guard.sh", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": "Task 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify's _HOOK_SOURCE_EXTS lacks .tf/.tfvars/.yaml/.yml and no env var extends it; wrapper handles those four and delegates everything else to graphify hook-guard read untouched."}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_doc_stale_hook", "label": ".claude/hooks/graphify-doc-stale.sh (SessionStart)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": "Task 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify's needs_update flag is written only by graphify watch; git hooks are AST-only and inert in worktrees, so a find -newer check covers both gaps."}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_settings_hook_wiring", "label": ".claude/settings.json hook wiring for graphify", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": "Task 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "--strict deliberately not used: it hard-denies the first raw Read and the graph never covers everything (.envrc, Dockerfile, .tftpl). $CLAUDE_PROJECT_DIR used because relative paths break in worktree sessions."}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_project_skill", "label": ".claude/skills/graphify/SKILL.md", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": "Task 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept short: vendoring graphify's 40 KB skill plus references costs context every session without repo-specific value."}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_git_hooks", "label": "graphify post-commit/post-checkout git hooks (merge driver stripped)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": "Task 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merge driver removed because graph.json is ignored; a .gitattributes line naming it would falsely signal the graph is tracked."}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_ci_semantic_cache_job", "label": ".github/workflows/graphify-semantic-cache.yml", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": "Task 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Master only: content-hash filenames make entries conflict-free between files, single-branch ownership makes them conflict-free within one; claude[bot] guard prevents self-retrigger."}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_graffiti_removal", "label": "Task 11: remove graffiti (last)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": "Task 11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graffiti is the control until graphify has passed both gates."}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_terraform_guard_inactive", "label": "Finding: terraform spend guard not active", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": "Out of scope", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "guard-terraform.sh is registered nowhere and settings.local.json sets bypassPermissions, so both documented layers are inert."}], "edges": [{"source": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_gate2_semantic_cache_replay", "target": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_gitignore_nested_reinclusion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": "Task 3 Interfaces", "weight": 1}, {"source": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_ci_semantic_cache_job", "target": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_gate2_semantic_cache_replay", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": "Task 9 Interfaces", "weight": 1}, {"source": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_ci_semantic_cache_job", "target": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_gitignore_nested_reinclusion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": "Task 9 Interfaces", "weight": 1}, {"source": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_settings_hook_wiring", "target": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_read_guard_wrapper", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": "Task 6", "weight": 1}, {"source": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_settings_hook_wiring", "target": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_doc_stale_hook", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "so
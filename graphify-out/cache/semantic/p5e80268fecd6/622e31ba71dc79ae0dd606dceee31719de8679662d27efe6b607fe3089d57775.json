{"nodes": [{"id": "docs_superpowers_plans_2026_08_31_ecs_dynamodb_rps_ceiling_attribution_via_metrics", "label": "Attribution-via-Metrics Implementation Plan (2026-08-31)", "file_type": "document", "source_file": "docs/superpowers/plans/2026-08-31-ecs-dynamodb-rps-ceiling-attribution-via-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Move every measurement signal off the service's HTTP surface into the OpenTelemetry pipeline; status complete 2026-08-31, squashed to master as b6234a3."}, {"id": "docs_superpowers_plans_2026_08_31_ecs_dynamodb_rps_ceiling_attribution_via_metrics_phase_histograms", "label": "http.server.db.duration / http.server.cpu.duration histograms", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-31-ecs-dynamodb-rps-ceiling-attribution-via-metrics.md", "source_location": "Task 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two separate exponential histograms sharing one attribute set so queries can subtract one from another without a join that drops series; absent (not zero) for /healthz so no misleading series is minted."}, {"id": "docs_superpowers_plans_2026_08_31_ecs_dynamodb_rps_ceiling_attribution_via_metrics_server_timing_removal", "label": "Delete Server-Timing header and GET /stats", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-31-ecs-dynamodb-rps-ceiling-attribution-via-metrics.md", "source_location": "Tasks 4-5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/stats duplicated RuntimeNodeInstrumentation's nodejs.eventloop.delay and v8js heap metrics; measurement should not leave over HTTP."}, {"id": "docs_superpowers_plans_2026_08_31_ecs_dynamodb_rps_ceiling_attribution_via_metrics_aws_instrumentation_verdict", "label": "AwsInstrumentation removal verdict (ruling R-1)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-31-ecs-dynamodb-rps-ceiling-attribution-via-metrics.md", "source_location": "Task 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A tracing-only instrumentation emitting no metrics is dead weight on a 250 \u00b5s/request budget; misconfigured components should be repaired, not deleted."}, {"id": "docs_superpowers_plans_2026_08_31_ecs_dynamodb_rps_ceiling_attribution_via_metrics_queries_json", "label": "grafana/queries.json shared query set (renderQueries)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-ecs-dynamodb-rps-ceiling-attribution-via-metrics.md", "source_location": "Task 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every query the dashboard, /loadtest and README read is defined once, generated from slo.yaml, so they cannot drift."}, {"id": "docs_superpowers_plans_2026_08_31_ecs_dynamodb_rps_ceiling_attribution_via_metrics_four_row_attribution_table", "label": "Four-row attribution table (bound resource inference)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-31-ecs-dynamodb-rps-ceiling-attribution-via-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Driven by ThrottledRequests, SuccessfulRequestLatency, the queueing gap and cpu saturation; later deleted after misattributing a known DB throttling case."}, {"id": "docs_superpowers_plans_2026_08_31_ecs_dynamodb_rps_ceiling_attribution_via_metrics_sli_aggregation_fix", "label": "Task 10b: aggregate histograms before histogram_fraction", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-31-ecs-dynamodb-rps-ceiling-attribution-via-metrics.md", "source_location": "Task 10b", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-series fraction then sum yields NaN whenever any series has zero observations \u2014 on every deploy and permanently once the service scales 1\u21924 tasks."}, {"id": "docs_superpowers_plans_2026_08_31_ecs_dynamodb_rps_ceiling_attribution_via_metrics_pbkdf2_verdict", "label": "pbkdf2_iterations stays at 2662", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-31-ecs-dynamodb-rps-ceiling-attribution-via-metrics.md", "source_location": "Task 12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The measured span wraps burn() alone and cannot contain instrumentation; churning the value would make future runs incomparable. cpu phase is load-dependent wall-clock at 0.25 vCPU."}, {"id": "docs_superpowers_plans_2026_08_31_ecs_dynamodb_rps_ceiling_attribution_via_metrics_unfailable_verification", "label": "Lesson: verification steps that cannot fail", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-31-ecs-dynamodb-rps-ceiling-attribution-via-metrics.md", "source_location": "What this plan got wrong", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five of twelve plan defects were checks written from memory that could never fail; any command a plan asks an executor to run should be executed once at authoring time."}, {"id": "docs_superpowers_plans_2026_08_31_ecs_dynamodb_rps_ceiling_attribution_via_metrics_generate_slo", "label": "scripts/generate-slo.js (single generator)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-ecs-dynamodb-rps-ceiling-attribution-via-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One source (slo.yaml) renders k6 thresholds, capacity tfvars, classmap, alerts, locals and queries; generated files are never hand-edited and slo:check byte-compares them."}, {"id": "docs_superpowers_plans_2026_08_31_ecs_dynamodb_rps_ceiling_attribution_via_metrics_otel_js", "label": "src/otel.js recordRequest", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-ecs-dynamodb-rps-ceiling-attribution-via-metrics.md", "source_location": "Task 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_plans_2026_08_31_ecs_dynamodb_rps_ceiling_attribution_via_metrics_timing_phases", "label": "src/timing.js phases() in seconds", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-ecs-dynamodb-rps-ceiling-attribution-via-metrics.md", "source_location": "Task 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conversion to seconds lives once in the timer because histograms use unit 's'; a 1000x error would be invisible until a panel read it."}, {"id": "docs_superpowers_plans_2026_08_31_ecs_dynamodb_rps_ceiling_attribution_via_metrics_k6_pure_gate", "label": "k6 records only client-observable metrics", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-31-ecs-dynamodb-rps-ceiling-attribution-via-metrics.md", "source_location": "Task 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase timings and event-loop lag come from OpenTelemetry via Grafana; nothing in the service exists for k6's benefit."}, {"id": "docs_superpowers_plans_2026_08_31_ecs_dynamodb_rps_ceiling_attribution_via_metrics_approval_gate", "label": "terraform apply/destroy approval gate", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-31-ecs-dynamodb-rps-ceiling-attribution-via-metrics.md", "source_location": "Global Constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every apply/destroy is its own task that stops for approval; never -auto-approve."}, {"id": "docs_superpowers_plans_2026_08_31_ecs_dynamodb_rps_ceiling_attribution_via_metrics_container_rebuild", "label": "Terraform does not rebuild the container image", "file_
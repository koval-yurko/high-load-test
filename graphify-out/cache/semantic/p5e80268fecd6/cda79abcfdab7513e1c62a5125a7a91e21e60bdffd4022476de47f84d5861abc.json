{"nodes": [{"id": "ecs_dynamodb_rps_readme", "label": "ecs-dynamodb-rps README", "file_type": "document", "source_file": "ecs-dynamodb-rps/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "ecs_dynamodb_rps_project", "label": "ecs-dynamodb-rps project", "file_type": "concept", "source_file": "ecs-dynamodb-rps/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named for the scenario (Node.js on ECS Fargate over provisioned-capacity DynamoDB) rather than the platform alone, per the repo's <platform>-<scenario> naming rule; the name is fixed because it is also the Project tag on every AWS resource."}, {"id": "ecs_dynamodb_rps_slo_latency_classes", "label": "SLO: ecs-dynamodb-rps latency classes", "file_type": "concept", "source_file": "ecs-dynamodb-rps/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Set at 95% (not 99%) because at 99% the error budget was too small to observe any burn: the idle heartbeat alone spent 166% of the week's budget with no load running, and a clean constant run at capacity spent another 67% \u2014 at 95% those become 33% and 13%, five times more legible. The primary objective's floor is 93.06%: below it the 14.4x fast-burn rule would need a miss rate over 100% and could never fire (enforced by service/test/generate-slo.test.js)."}, {"id": "ecs_dynamodb_rps_dashboard_attribution", "label": "Grafana dashboard: ecs-dynamodb-rps \u2014 attribution", "file_type": "concept", "source_file": "ecs-dynamodb-rps/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "ecs_dynamodb_rps_alert_fast_burn", "label": "Alert: fast burn (x3 objectives)", "file_type": "concept", "source_file": "ecs-dynamodb-rps/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "ecs_dynamodb_rps_alert_slow_burn", "label": "Alert: slow burn (x3 objectives)", "file_type": "concept", "source_file": "ecs-dynamodb-rps/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "ecs_dynamodb_rps_alert_sli_absent", "label": "Alert: SLI absent", "file_type": "concept", "source_file": "ecs-dynamodb-rps/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exists because every burn-rate rule treats 'no data' as OK (correctly, since no traffic isn't a burn) \u2014 so a dead heartbeat or stopped collector would leave all burn rules silent and the dashboard flat. This rule separates 'quiet' from 'blind'."}, {"id": "ecs_dynamodb_rps_alert_throttling", "label": "Alert: DynamoDB read/write throttling", "file_type": "concept", "source_file": "ecs-dynamodb-rps/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implemented as two separate rules (read/write) rather than one summed rule, because read-only throttling would have silenced a combined rule exactly when it mattered (infra/grafana/throttles.tf)."}], "edges": [{"source": "ecs_dynamodb_rps_readme", "target": "ecs_dynamodb_rps_project", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "ecs-dynamodb-rps/README.md", "source_location": null, "weight": 1}, {"source": "ecs_dynamodb_rps_readme", "target": "ecs_dynamodb_rps_slo_latency_classes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "ecs-dynamodb-rps/README.md", "source_location": null, "weight": 1}, {"source": "ecs_dynamodb_rps_readme", "target": "ecs_dynamodb_rps_dashboard_attribution", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "ecs-dynamodb-rps/README.md", "source_location": null, "weight": 1}, {"source": "ecs_dynamodb_rps_readme", "target": "ecs_dynamodb_rps_alert_fast_burn", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "ecs-dynamodb-rps/README.md", "source_location": null, "weight": 1}, {"source": "ecs_dynamodb_rps_readme", "target": "ecs_dynamodb_rps_alert_slow_burn", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "ecs-dynamodb-rps/README.md", "source_location": null, "weight": 1}, {"source": "ecs_dynamodb_rps_readme", "target": "ecs_dynamodb_rps_alert_sli_absent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "ecs-dynamodb-rps/README.md", "source_location": null, "weight": 1}, {"source": "ecs_dynamodb_rps_readme", "target": "ecs_dynamodb_rps_alert_throttling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "ecs-dynamodb-rps/README.md", "source_location": null, "weight": 1}], "hyperedges": [{"id": "ecs_dynamodb_rps_slo_alerting_system", "label": "ecs-dynamodb-rps SLO and alerting rules", "nodes": ["ecs_dynamodb_rps_slo_latency_classes", "ecs_dynamodb_rps_alert_fast_burn", "ecs_dynamodb_rps_alert_slow_burn", "ecs_dynamodb_rps_alert_sli_absent", "ecs_dynamodb_rps_alert_throttling"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 0.8, "source_file": "ecs-dynamodb-rps/README.md"}]}
0-ecs-rds-postgres-pool-service.md", "source_location": null, "weight": 0.85}, {"source": "service_calibrate_searchscanrows", "target": "service_db_createrepo", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "docs/superpowers/plans/2026-09-20-ecs-rds-postgres-pool-service.md", "source_location": null, "weight": 0.85}, {"source": "service_calibrate_searchscanrows", "target": "service_pool_instrumentconnect", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "docs/superpowers/plans/2026-09-20-ecs-rds-postgres-pool-service.md", "source_location": null, "weight": 0.85}, {"source": "service_generateslo_validateslo", "target": "service_slo_yaml", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/superpowers/plans/2026-09-20-ecs-rds-postgres-pool-service.md", "source_location": null, "weight": 0.9}, {"source": "service_handlers_routeclass", "target": "service_slo_yaml", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/superpowers/plans/2026-09-20-ecs-rds-postgres-pool-service.md", "source_location": null, "weight": 0.9}, {"source": "docs_superpowers_plans_2026_09_20_ecs_rds_postgres_pool_service", "target": "ecs_dynamodb_rps", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/superpowers/plans/2026-09-20-ecs-rds-postgres-pool-service.md", "source_location": null, "weight": 0.9}, {"source": "service_db_createrepo", "target": "docs_research_ecs_rds_postgres_pool_c11_comparability", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.55, "source_file": "docs/superpowers/plans/2026-09-20-ecs-rds-postgres-pool-service.md", "source_location": null, "weight": 0.55}, {"source": "service_dockerfile", "target": "ecs_dynamodb_rps", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.5, "source_file": "docs/superpowers/plans/2026-09-20-ecs-rds-postgres-pool-service.md", "source_location": null, "weight": 0.5}], "hyperedges": [{"id": "pool_wait_attribution_chain", "label": "Pool-wait attribution chain answering D7", "nodes": ["service_context_asynclocalstorage", "service_pool_instrumentconnect", "service_otel_starttelemetry", "service_handlers_routeclass", "docs_research_ecs_rds_postgres_pool_d7_pool_wait_source"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/superpowers/plans/2026-09-20-ecs-rds-postgres-pool-service.md"}, {"id": "sql_workload_design", "label": "The calibrated SQL workload design (schema, cost knob, routes)", "nodes": ["service_prisma_schema", "service_db_createrepo", "service_handlers_routeclass", "docs_research_ecs_rds_postgres_pool_c1_pool_binding_constraint", "docs_research_ecs_rds_postgres_pool_d6_fork_depth"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.7, "source_file": "docs/superpowers/plans/2026-09-20-ecs-rds-postgres-pool-service.md"}]}
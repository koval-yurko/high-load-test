{"nodes": [{"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline", "label": "Plan 3: calibration and baseline", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "plan3_d1_sleep_knob", "label": "D1: heavy route sleep knob (REPORT_SLEEP_MS)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A CPU-only hold puts 5 connections at ~2.5x the 2 vCPUs before the pool binds (load = pool_size x f / vCPUs); splitting CPU work from a timed pg_sleep makes the CPU fraction a solvable knob. Metric changes to DBLoadCPU/vCPUs because pg_sleep sessions count as active."}, {"id": "plan3_d2_mean_hold", "label": "D2: calibrate against mean hold across the mix", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan 1 aimed 20 ms at the heavy statement alone though reports are 1 in 20 of the mix, putting the knee above 1000 rps; solving for mean hold reduces to mean_db_cpu/mean_hold = 0.2."}, {"id": "plan3_d3_thresholds", "label": "D3: thresholds = 3x unloaded server-side p99", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Breaks the circle between VU sizing and thresholds via a throwaway low-rate probe; 3x absorbs jitter at low load while pool queueing still crosses it near the knee."}, {"id": "plan3_d4_oneoff_tasks", "label": "D4: seed and calibrate as in-VPC one-off Fargate tasks", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hold time measured from a laptop would carry tens of ms of internet RTT against a 20 ms target; also removes a second apply since seed_on_boot stays false."}, {"id": "plan3_d5_no_reset", "label": "D5: posts table not reset between runs", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "plan3_calibrate_js", "label": "calibrate.js (solveKnobs, readMix)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Tasks 4, 18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "readMix takes CAPACITY_MIX as JSON because slo.yaml is outside the Docker context and yaml is a devDependency omitted in the runtime image."}, {"id": "plan3_run_oneoff_sh", "label": "run-oneoff.sh", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Task 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaced aws ecs wait (fixed 10 min ceiling) with a bounded poll so long runs do not die with a raw waiter error."}, {"id": "plan3_db_report_cte", "label": "db.js report CTE with pg_sleep", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Task 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sleep is inside the same statement so the hold stays one checkout; MATERIALIZED prevents the optimiser dropping it."}, {"id": "plan3_report_sleep_ms", "label": "REPORT_SLEEP_MS / report_sleep_ms knob", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Task 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "plan3_freeze_thresholds_task", "label": "Freeze thresholds and generate derived files (Task 11)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Task 11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "plan3_baseline_runs", "label": "Discovery, constant and stress baseline at pool 5", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Tasks 14-15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stress must exit 99 first: the red half of the red-green loop proves the SLO assertion can fail before any knob is changed."}, {"id": "plan3_results_md", "label": "results.md run ledger", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Task 13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "plan3_readme_runbook", "label": "README as runbook", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Task 20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline", "target": "docs_superpowers_s
{"nodes": [{"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline", "label": "Plan 3: calibration and baseline", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_d1_sleep_knob", "label": "D1: heavy route gets timed pg_sleep beside the scan", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Decisions D1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A CPU-only hold puts 5 connections at ~2.5x the 2 vCPUs before the pool binds (load = 5f/2, target needs f~0.2); splitting into scan CPU and a timed wait makes f a solvable knob. DBLoadCPU/vCPUs replaces DBLoadRelativeToNumVCPUs since pg_sleep counts as an active session."}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_d2_mean_hold", "label": "D2: calibrate to the mean hold across the mix", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Decisions D2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan 1 targeted 20ms on the heavy statement alone; a report is 1 in 20 requests, so the mean hold would be a few ms and the knee above 1000 rps. The mean/CPU ratio cancels the knee: mean_db_cpu/mean_hold = target_cpu*vcpus/pool = 0.2."}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_d3_thresholds", "label": "D3: class thresholds = 3x unloaded server-side p99", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Decisions D3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Breaks the circularity between thresholds and VU sizing using a throwaway 10 rps probe; 3x avoids jitter breaches at low load while pool queueing still crosses near the knee. pool_connection_timeout_ms = heavy + 100 ms so overload lands as 5xx."}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_d4_oneoff_tasks", "label": "D4: seed and calibrate as in-VPC one-off Fargate tasks", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Decisions D4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hold time measured from a laptop would carry tens of ms of internet RTT; also removes a second apply since seed_on_boot stays false."}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_d5_no_reset", "label": "D5: posts table not reset; size recorded", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Decisions D5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_solveknobs", "label": "solveKnobs", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Task 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Little's law fixes the knee; cancelling it leaves meanDbCpu/meanHold = targetCpuRelative*vcpus/poolSize, solved for the heavy route's two costs."}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_calibrate_js", "label": "scripts/calibrate.js", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Tasks 4, 18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_readmix", "label": "readMix (CAPACITY_MIX)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Task 18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "slo.yaml is outside the Docker context and yaml is a devDependency omitted from the runtime image, so the mix is read on the operator machine and passed as JSON."}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_run_oneoff", "label": "scripts/run-oneoff.sh", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Task 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaced aws ecs wait tasks-stopped (fixed 10 minute limit) with a bounded poll of describe-tasks."}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_report_sleep_ms", "label": "REPORT_SLEEP_MS / report_sleep_ms", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Tasks 3, 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_report_scan_rows", "label": "REPORT_SCAN_ROWS / report_scan_rows", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Tasks 3, 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_apply_gates", "label": "Apply/destroy gate tasks (1, 7, 10, 12, 17)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Tasks 1,7,10,12,17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_loadtest_skill", "label": "/loadtest skill per-project columns", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Task 13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_baseline_runs", "label": "Discovery, constant and stress baseline runs at pool 5", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Tasks 14-15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The stress run must exit 99 before any knob moves; this is the red half of the red-green loop."}], "edges": [{"source": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline", "target": "docs_superpowers_plans_2026_09_21_ecs_rds_postgres_pool_infrastructure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": "Predecessors", "weight": 1}, {"source": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline", "target": "docs_superpowers_plans_2026_09_21_ecs_rds_postgres_pool_infrastructure_plan3_handoff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_fil
{"nodes": [{"id": "docs_research_ecs_rds_postgres_pool", "label": "Research: ecs-rds-postgres-pool", "file_type": "document", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_research_ecs_rds_postgres_pool_c1_pool_binding", "label": "C1 making the pool the binding constraint", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "By Little's law a pool of 5 with 2ms queries serves 2500 qps, so a point-select workload never binds the pool; a calibrated cost knob inside hold time is needed."}, {"id": "docs_research_ecs_rds_postgres_pool_c2_prisma_pool", "label": "C2 Prisma owns the pool", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prisma metrics feature removed in 7.0.0; resolution is pg.Pool via @prisma/adapter-pg."}, {"id": "docs_research_ecs_rds_postgres_pool_c4_rds_proxy", "label": "C4 RDS Proxy moves the wait", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expected result against few long-lived ECS tasks is no attainment gain; pre-register it. Session pinning can silently turn proxy into passthrough."}, {"id": "docs_research_ecs_rds_postgres_pool_c5_max_connections", "label": "C5 max_connections cliff", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "db.t4g.micro has about 112 connections; pool 25 x 4 tasks = 100."}, {"id": "docs_research_ecs_rds_postgres_pool_c6_credits", "label": "C6 T-class CPU credits", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "aws_db_instance has no credit_specification, so credit mode is unsettable; record balance per run and disqualify depleted runs."}, {"id": "docs_research_ecs_rds_postgres_pool_c10_survivors", "label": "C10 teardown survivors", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_research_ecs_rds_postgres_pool_d5", "label": "D5 second knob decision", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_research_ecs_rds_postgres_pool_d7", "label": "D7 pool-wait source decision", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Option (a): own pg.Pool via adapter and attribute with AsyncLocalStorage; (b)/(c) impossible since Prisma metrics removed."}, {"id": "docs_research_ecs_rds_postgres_pool_three_queues", "label": "Three queues: event loop, pool checkout, Postgres backend", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_research_ecs_rds_postgres_pool_dbload_relative", "label": "DBLoadRelativeToNumVCPUs saturation signal", "file_type": "concept", "source_file": "docs/research/ecs-rds-postgres-pool.md", "source_location": null, "source_url": null, "captured_at": n
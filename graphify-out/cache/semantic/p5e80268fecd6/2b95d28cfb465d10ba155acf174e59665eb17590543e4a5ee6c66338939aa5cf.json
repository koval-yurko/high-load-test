{"nodes": [{"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling", "label": "Plan: ecs-dynamodb-rps-ceiling (2026-08-29)", "file_type": "document", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Status complete; Tasks 18-23 re-homed to the observability-shakedown and scale-and-measure plans to prove the free-tier environment before spending on capacity"}, {"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling_mix_55_15_25_5", "label": "Frozen 55/15/25/5 request mix", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic 20-iteration cycle, not Math.random, so sampling variance cannot surface as a result difference"}, {"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling_loadconfig", "label": "loadConfig", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling_burn", "label": "burn (pbkdf2 CPU knob)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pbkdf2Sync blocks the event loop, producing a sharp knee and catastrophic queueing a latency SLO should catch; calibrated to 2662 iterations on real Fargate"}, {"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling_createtimer", "label": "createTimer (Server-Timing phases)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling_snapshot", "label": "snapshot (event-loop lag stats)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling_builditem", "label": "buildItem / PAYLOAD_BYTES=940", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "965-byte items make a 20-item Query exactly 5 read blocks = 2.5 RCU eventually consistent, the capacity model's coefficient"}, {"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling_createrepo", "label": "createRepo (DynamoDB access)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ConsistentRead:false is load-bearing; flipping it doubles every read coefficient"}, {"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling_createhandlers", "label": "createHandlers", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling_matchroute", "label": "matchRoute", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET /feeds/:pk instead of /items/:pk/feed to avoid collision with /items/:pk/:sk"}, {"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling_createserver", "label": "createServer (raw node:http)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No Express: framework overhead is a meaningful fraction of the 250 \u00b5s/request CPU budget"}, {"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling_seeditems", "label": "seedItems (50 partitions x 20 items)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fifty partitions so a narrow key range cannot hit per-partition limits and masquerade as a service ceiling"}, {"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling_iterationsfor", "label": "iterationsFor (calibrate.js)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must run on the 0.25 vCPU target, not a laptop"}, {"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling_dorequest", "label": "doRequest (k6 request library)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling_k6_profiles", "label": "k6 discovery / constant / stress profiles", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discovery aborts at the knee so the arrival rate at abort is the capacity number; stress holds 2 min at peak because DynamoDB banks ~300 s of burst"}, {"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling_class_threshold_ratio", "label": "class_threshold_ratio SLI", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A percentile cannot compose across endpoints of different cost and cannot produce an error budget; each request is judged against its own class threshold"}, {"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling_throttledrequests_discriminator", "label": "ThrottledRequests as the DB-bound discriminator", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "db_ms is wall-clock around an await and inflated 12.1x under CPU saturation; ThrottledRequests is measured inside DynamoDB and cannot be contaminated"}, {"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling_burst_drain", "label": "Mandatory 6-minute burst-bucket drain", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DynamoDB banks ~300 s of unused capacity, so runs are only comparable from a full bucket"}, {"id": "docs_superpowers_plans_2026_08_29_ecs_dynamodb_rps_ceiling_terraform_infra", "label": "Terraform: network, ALB, ECR, DynamoDB, ECS, autoscaling", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-29-ecs-dynamodb-rps-ceiling.md"
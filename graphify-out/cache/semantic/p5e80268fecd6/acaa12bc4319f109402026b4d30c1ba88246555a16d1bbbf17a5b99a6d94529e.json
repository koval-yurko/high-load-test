{"nodes": [{"id": "docs_superpowers_specs_2026_10_11_ecs_rds_postgres_pool_tracing_design", "label": "ecs-rds-postgres-pool request tracing spec (phase 1)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-10-11-ecs-rds-postgres-pool-tracing-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discovery run 8787587 broke between 100 and 200 rps and the cause had to be inferred from Performance Insights; metrics cannot say which request or SQL statement was slow."}, {"id": "ecs_rds_postgres_pool_tracing_sink_tempo", "label": "Trace sink: Grafana Cloud Tempo via Alloy gateway", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-11-ecs-rds-postgres-pool-tracing-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AWS X-Ray rejected: Alloy has no X-Ray exporter, so it needs an extra ADOT collector or SigV4 signing plus task-role IAM, and traces would sit apart from the SLO dashboards."}, {"id": "ecs_rds_postgres_pool_tracing_otel_auto_instrumentation", "label": "OpenTelemetry auto-instrumentation (http, pg) via --import", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-11-ecs-rds-postgres-pool-tracing-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manual spans deferred to phase 2 so the user can see what libraries give for free first."}, {"id": "ecs_rds_postgres_pool_tracing_sampling_knob", "label": "TRACE_SAMPLE_RATIO / trace_sample_ratio knob", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-11-ecs-rds-postgres-pool-tracing-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "100% sampling by default; knob leaves room for low ratio or tail sampling. Part of the knobs output because tracing runs inside the 0.5 vCPU task under test and must be held constant across compared runs."}, {"id": "ecs_rds_postgres_pool_tracing_preload_module", "label": "service/src/tracing.js preload module", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-11-ecs-rds-postgres-pool-tracing-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must run before server.js imports node:http and pg, so it cannot live inside startTelemetry called from main()."}, {"id": "ecs_rds_postgres_pool_tracing_alloy_collector", "label": "Alloy collector (alloy.alloy.tftpl) traces pipeline", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-11-ecs-rds-postgres-pool-tracing-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "ecs_rds_postgres_pool_tracing_traces_write_scope", "label": "Grafana token traces:write scope (manual step)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-11-ecs-rds-postgres-pool-tracing-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Token behind GRAFANA_OTLP_PASSWORD is scoped metrics:write; Tempo ingest needs traces:write, which no code can add."}, {"id": "ecs_rds_postgres_pool_tracing_phase2_manual_spans", "label": "Phase 2: manual inner spans (not yet written)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-11-ecs-rds-postgres-pool-tracing-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-instrumentation gives no span for Prisma in-process work, body read, handler, summarize CPU step or serialization."}, {"id": "ecs_rds_postgres_pool_tracing_overhead_unmeasured", "label": "Tracing overhead criterion (unmet, descoped)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-11-ecs-rds-postgres-pool-tracing-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Descoped by the user on 2026-10-12 (plan Task 10 not run); cost of ratio 1 on 0.5 vCPU task remains unmeasured."}], "edges": [{"source": "docs_superpowers_specs_2026_10_11_ecs_rds_postgres_pool_tracing_design", "target": "ecs_rds_postgres_pool_tracing_sink_tempo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-10-11-ecs-rds-postgres-pool-tracing-design.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_specs_2026_10_11_ecs_rds_postgres_pool_tracing_design", "target": "ecs_rds_postgres_pool_tracing_otel_auto_instrumentation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-10-11-ecs-rds-postgres-pool-tracing-design.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_specs_2026_10_11_ecs_rds_postgres_pool_tracing_design", "target": "ecs_rds_postgres_pool_tracing_sampling_knob", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-10-11-ecs-rds-postgres-pool-tracing-design.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_specs_2026_10_11_ecs_rds_postgres_pool_tracing_design", "target": "ecs_rds_postgres_pool_tracing_preload_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-10-11-ecs-rds-postgres-pool-tracing-design.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_specs_2026_10_11_ecs_rds_postgres_pool_tracing_design", "target": "ecs_rds_postgres_pool_tracing_alloy_collector", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-1
{"nodes": [{"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design", "label": "ecs-dynamodb-rps-ceiling Design Spec (2026-08-29)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design", "label": "Spec: ecs-dynamodb-rps-ceiling design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Find max sustainable RPS on ECS Fargate holding an SLO, exceed it, change one thing, re-measure; also prove the measurement loop itself as the repo's first project."}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d1_dynamodb", "label": "D1: DynamoDB over DocumentDB/RDS", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fastest provision/destroy, no NAT, no hourly instance cost, and decisively no burstable CPU credits that would make runs incomparable."}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d5_ratio_sli", "label": "D5: ratio SLI with per-class thresholds", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": "\u00a72, \u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A percentile cannot compose across heterogeneous endpoints nor produce an error budget, and grafana_slo only accepts Success/Total ratios."}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d6_provisioned", "label": "D6: DynamoDB PROVISIONED billing", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provisioned converts overload into visible throttling (a hard ceiling) rather than into bill; not chosen for savings, since break-even is ~29% utilisation."}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d7_k6_sli_source", "label": "D7: k6 metrics as SLI source (REVERSED)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reversed: its justification (no CloudWatch datasource/IAM) was false, and an SLI that only exists during a load test is not a service level indicator."}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d9_pbkdf2_cpu_work", "label": "D9: pbkdf2Sync CPU work, tunable iterations", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic and allocation-free; blocks the event loop by design to produce a sharp knee a latency SLO should catch."}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d10_server_timing", "label": "D10: Server-Timing + /stats instrumentation (REVERSED)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": "\u00a72, \u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_capacity_model", "label": "Capacity model: RCU = 1.025R, WCU = 0.200R at 55/15/25/5 mix", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bytes returned per request is the cost driver: the feed Query is 61% of RCU at 25% of traffic. Prices fetched from the AWS Pricing API, never remembered."}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_slo_objective", "label": "SLO objective: class thresholds fast 50ms / standard 200ms / heavy 800ms", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_load_profiles", "label": "Load profiles A discovery / B constant / C stress (arrival-rate)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arrival-rate executors, never ramping-vus, because VUs measure concurrency not throughput; endpoint mix enforced deterministically by iterationInTest % 20."}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_burst_capacity_hazard", "label": "Hazard: DynamoDB burst capacity (~300s) requires fixed warm-up/drain", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_no_nat_gateway", "label": "Public subnets + DynamoDB gateway endpoint, no NAT gateway", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NAT gateway costs ~$32/month and is the most common teardown survivor; gateway endpoints are not billed hourly."}], "edges": [{"source": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_slo_objective", "target": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d5_ratio_sli", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": "\u00a77", "weight": 1}, {"source": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_capacity_model", "target": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d6_provisioned", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": "\u00a76", "weight": 1}, {"source": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_burst_capacity_hazard", "target": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d6_provisioned", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": "\u00a710", "weight": 1}, {"source": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_burst_capacity_hazard", "target": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d1_dynamodb", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": "\u00a710", "weight": 1}, {"source": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d1_dynamodb", "target": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_no_nat_gateway", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": "\u00a72, \u00a74", "weight": 1}], "hyperedges": []}
{"nodes": [{"id": "docs_superpowers_specs_2026_09_19_graffiti_to_graphify_design", "label": "Graffiti-to-graphify design spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-graffiti-to-graphify-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capability (communities, god-nodes, path, explain, affected), not breakage."}, {"id": "docs_superpowers_specs_2026_09_19_graffiti_to_graphify_design_terraform_extra", "label": "D2: graphifyy[terraform] extra is a prerequisite", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-graffiti-to-graphify-design.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without it 33 of 81 code files (.tf/.hcl/.tfvars) are silently absent."}, {"id": "docs_superpowers_specs_2026_09_19_graffiti_to_graphify_design_read_guard_wrapper", "label": "D4: local read-guard wrapper adding .tf/.tfvars/.yaml/.yml", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-graffiti-to-graphify-design.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify's read guard extension list is hardcoded and not configurable; --strict rejected because the graph never covers everything."}, {"id": "docs_superpowers_specs_2026_09_19_graffiti_to_graphify_design_commit_semantic_cache", "label": "D6: commit graphify-out/cache/semantic*/ via nested re-inclusion", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-graffiti-to-graphify-design.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic extraction costs LLM calls; entries are content-hash keyed, portable and conflict-free. Simple negation silently re-includes nothing."}, {"id": "docs_superpowers_specs_2026_09_19_graffiti_to_graphify_design_ci_semantic_cache_workflow", "label": "D8/D9: CI on master regenerates semantic cache via claude-cli", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-graffiti-to-graphify-design.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Master-only makes entries conflict-free within one branch; cache entries carry no timestamps so no empty commits."}, {"id": "docs_superpowers_specs_2026_09_19_graffiti_to_graphify_design_doc_stale_hook", "label": "D11: SessionStart mtime doc-staleness hook", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-graffiti-to-graphify-design.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "needs_update is only written by graphify watch; git hooks are inert in worktrees."}, {"id": "docs_superpowers_specs_2026_09_19_graffiti_to_graphify_design_gate1_result", "label": "Gate 1 result: graphify 17 Terraform nodes vs graffiti 0", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-graffiti-to-graphify-design.md", "source_location": "\u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_09_19_graffiti_to_graphify_design_claude_cli_probe", "label": "\u00a712 probe: claude-cli backend extraction, byte-stable cache", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-graffiti-to-graphify-design.md", "source_location": "\u00a712", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "docs_superpowers_specs_2026_09_19_graffiti_to_graphify_design", "target": "docs_superpowers_specs_2026_09_19_graffiti_to_graphify_design_terraform_extra", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/s
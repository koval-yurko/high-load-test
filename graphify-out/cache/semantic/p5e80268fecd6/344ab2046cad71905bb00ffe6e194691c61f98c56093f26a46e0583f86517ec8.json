{"nodes": [{"id": "docs_superpowers_plans_2026_09_02_ecs_dynamodb_rps_scale_and_measure", "label": "Scale-and-Measure Implementation Plan (2026-09-02)", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-02-ecs-dynamodb-rps-scale-and-measure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discover the SLO-breaking request rate, release one constraint at a time (autoscaling 1\u21924, then capacity) and re-measure identically; re-homes Tasks 18\u201323 of the 2026-08-29 plan."}, {"id": "docs_superpowers_plans_2026_09_02_ecs_dynamodb_rps_scale_and_measure_k6_user_agent", "label": "Task 1 Step 0: make k6 traffic identifiable", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-02-ecs-dynamodb-rps-scale-and-measure.md", "source_location": "Task 1 Step 0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "k6 v1.4.0 sends no k6/ User-Agent so traffic_source=\"k6\" is an empty population that reads like healthy silence; must land before the script freeze."}, {"id": "docs_superpowers_plans_2026_09_02_ecs_dynamodb_rps_scale_and_measure_script_freeze", "label": "Load profile freeze after discovery", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-02-ecs-dynamodb-rps-scale-and-measure.md", "source_location": "Task 2 Step 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A load profile is only comparable to itself; change infrastructure, never the script."}, {"id": "docs_superpowers_plans_2026_09_02_ecs_dynamodb_rps_scale_and_measure_burst_bucket_idle", "label": "6-minute idle to refill DynamoDB burst bucket", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-02-ecs-dynamodb-rps-scale-and-measure.md", "source_location": "Global Constraint 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DynamoDB banks ~300 s of unused capacity; a run from a partially drained bucket is not comparable."}, {"id": "docs_superpowers_plans_2026_09_02_ecs_dynamodb_rps_scale_and_measure_two_attainments", "label": "k6 attainment vs service attainment (run-scoped)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-02-ecs-dynamodb-rps-scale-and-measure.md", "source_location": "Task 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "k6 is the client-side gate; service attainment over the run's own window is authoritative because the 7-day window's idle population noise floor exceeds the objective."}, {"id": "docs_superpowers_plans_2026_09_02_ecs_dynamodb_rps_scale_and_measure_capacity_pin", "label": "Capacity pin in dev.tfvars and HCP workspace variables", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-02-ecs-dynamodb-rps-scale-and-measure.md", "source_location": "Task 1 Step 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Workspace variables outrank tfvars in a remote run, so releasing one pin silently accomplishes nothing."}], "edges": [{"source": "docs_superpowers_plans_2026_09_02_ecs_dynamodb_rps_scale_and_measure", "target": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-09-02-ecs-dynamodb-rps-scale-and-measure.md", "source_location": "Specs", "weight": 1}, {"source": "docs_superpowers_plans_2026_09_02_ecs_dynamodb_rps_scale_and_measure", "target": "docs_superpowers_specs_2026_09_01_ecs_dynamodb_rps_ceiling_attribution_simplified_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-09-02-ecs-dynamodb-rps-scale-and-measure.md", "source_location": "Status", "weight": 1}, {"source": "docs_superpowers_plans_2026_09_02_ecs_dynamo
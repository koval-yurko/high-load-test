{"nodes": [{"id": "docs_superpowers_specs_2026_09_15_ecs_dynamodb_rps_spike_response_design", "label": "Spike response design spec (floor of one task)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-15-ecs-dynamodb-rps-spike-response-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_09_15_ecs_dynamodb_rps_spike_response_design_run_8554820", "label": "Discovery run 8554820: knee at 200 rps on one 0.25 vCPU task", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-15-ecs-dynamodb-rps-spike-response-design.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_09_15_ecs_dynamodb_rps_spike_response_design_cpu_target_ceiling", "label": "CPU target tracking bounded at 1.67x per decision", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-15-ecs-dynamodb-rps-spike-response-design.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_09_15_ecs_dynamodb_rps_spike_response_design_requests_scaling", "label": "Change 1: ALBRequestCountPerTarget policy (6000/min) alongside CPU", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-15-ecs-dynamodb-rps-spike-response-design.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unbounded metric lets one decision reach the needed fleet size; CPU policy kept for expensive requests."}, {"id": "docs_superpowers_specs_2026_09_15_ecs_dynamodb_rps_spike_response_design_elu_step_scaling", "label": "Change 2: event-loop utilization high-res metric + step scaling", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-15-ecs-dynamodb-rps-spike-response-design.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PutMetricData over EMF avoids log ingestion delay; step not target tracking because ELU is bounded like CPU."}, {"id": "docs_superpowers_specs_2026_09_15_ecs_dynamodb_rps_spike_response_design_admission_control", "label": "Change 3: admission control, 429 + Retry-After above ELU 0.92", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-15-ecs-dynamodb-rps-spike-response-design.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing protects the first 2\u20133 minutes of a spike except the one running task; rejecting fast beats queueing."}, {"id": "docs_superpowers_specs_2026_09_15_ecs_dynamodb_rps_spike_response_design_shed_invariant", "label": "Invariant: every scale-out threshold strictly below shed threshold", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-15-ecs-dynamodb-rps-spike-response-design.md", "source_location": "\u00a76.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shedding clamps ELU near its threshold, so a lower shed threshold would silence the scaling alarm forever."}, {"id": "docs_superpowers_specs_2026_09_15_ecs_dynamodb_rps_spike_response_design_d4_4xx_divergence", "label": "D4: 4xx divergence between Grafana SLO and k6 knowingly accepted", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-15-ecs-dynamodb-rps-spike-response-design.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User declined adding 429 to expectedStatuses; for shedding runs Grafana carries the verdict, k6 exits 99."}, {"id": "docs_superpowers_specs_2026_09_15_ecs_dynamodb_rps_spike_response_design_desired_count_floor_bug", "label": "Prerequisite: desired_count vs autoscaling_min drift", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-15-ecs-dynamodb-rps-spike-response-design.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "docs_superpowers_specs_2026_09_15_ecs_dynamodb_rps_spike_response_design", "target": "docs_superpowers_specs_2026_09_15_ecs_dynamodb_rps_spike_response_design_run_8554820", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-15-ecs-dynamodb-rps-spike-response-design.md", "source_location": "\u00a71", "weight": 1}, {"source": "docs_superpowers_specs_2026_09_15_ecs_dynamodb_rps_spike_response_design_requests_scaling", "target": "docs_superpowers_specs_2026_09_15_ecs_dynamodb_rps_spike_response_design_cpu_target_ceiling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-15-ecs-dynamodb-rps-spike-response-design.md", "source_location": "\u00a74", "weight": 1}, {"source": "docs_superpowers_specs_2026_09_15_ecs_dynamodb_rps_spike_response_design_elu_step_scaling", "target": "docs_superpowers_specs_2026_09_15_ecs_dynamodb_rps_spike_response_design_cpu_target_ceiling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-15-ecs-dynamodb-rps-spike-response-design.md", "source_location": "\u00a75", "weight": 1}, {"source": "docs_superpowers_specs_2026_09_15_ecs_dynamodb_rps_spike_response_design_admission_control", "target": "docs_superpowers_specs_2026_09_15_ecs_dynamodb_rps_spike_response_design_elu_step_scaling", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-15-ecs-dynamodb-rps-spike-response-design.md", "source_location": "\u00a76", "weight": 1}, {"source": "docs_superpowers_specs_2
{"nodes": [{"id": "docs_superpowers_specs_2026_09_19_graffiti_to_graphify_design", "label": "graffiti to graphify design spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-19-graffiti-to-graphify-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "graphify_tool", "label": "graphify code map", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-graffiti-to-graphify-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over graffiti for community detection, god-nodes, path, explain and affected queries, at no API cost.", "_origin": "semantic"}, {"id": "graffiti_tool", "label": "graffiti code map (replaced)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-graffiti-to-graphify-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "graphify_terraform_extra", "label": "graphifyy[terraform] extra", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-graffiti-to-graphify-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without it 33 of 81 code files (.tf, .hcl, .tfvars) contribute nothing and it only warns, so the map looks complete when it is not.", "_origin": "semantic"}, {"id": "graphify_semantic_cache", "label": "Committed semantic cache (graphify-out/cache/semantic)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-graffiti-to-graphify-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It is the one output that costs LLM calls to recreate; entries are content-hash keyed, version-independent and conflict-free, so committing it shares paid work across clones and CI.", "_origin": "semantic"}, {"id": "graphify_gitignore_nested_reinclusion", "label": "Nested gitignore re-inclusion", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-19-graffiti-to-graphify-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git does not descend into an excluded directory, so a simple negation after graphify-out/ re-includes nothing and fails silently.", "_origin": "semantic"}, {"id": "graphify_read_guard_hook", "label": "graphify-read-guard.sh hook", "file_type": "code", "source_file": "docs/superpowers/specs/2026-09-19-graffiti-to-graphify-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify's read guard hardcodes an extension list that omits .tf, .tfvars, .yaml, .yml, with no config to extend it, so a local wrapper adds them.", "_origin": "semantic"}, {"id": "graphify_doc_stale_hook", "label": "graphify-doc-stale.sh SessionStart hook", "file_type": "code", "source_file": "docs/superpowers/specs/2026-09-19-graffiti-to-graphify-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify has no doc-staleness signal that fits; an mtime comparison needs no daemon and works in worktrees.", "_origin": "semantic"}, {"id": "graphify_semantic_cache_workflow", "label": "graphify-semantic-cache GitHub workflow", "file_type": "code", "source_file": "docs/superpowers/specs/2026-09-19-graffiti-to-graphify-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Master-only so entries cannot conflict within a branch; installs the claude CLI because graphify detects claude-cli backend by which(claude).", "_origin": "semantic"}], "edges": [{"source": "docs_superp
{"nodes": [{"id": "docs_superpowers_specs_2026_11_09_lambda_concurrency_limit_design", "label": "lambda-concurrency-limit design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-11-09-lambda-concurrency-limit-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_11_09_lambda_concurrency_limit_design_erlang_b", "label": "Erlang B concurrency sizing", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-09-lambda-concurrency-limit-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reserved concurrency without queue is a loss system; throttle budget is half the availability budget.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_11_09_lambda_concurrency_limit_design_shared_account", "label": "Shared account concurrency constraint (252 max)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-09-lambda-concurrency-limit-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without reserved concurrency a load test could empty the unreserved pool and throttle other apps.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_11_09_lambda_concurrency_limit_design_api_gateway_rest", "label": "API Gateway REST API front door", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-09-lambda-concurrency-limit-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-client throttling exists only on REST APIs.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_11_09_lambda_concurrency_limit_design_knobs", "label": "Three knobs: per-user limit, reserved concurrency, provisioned concurrency", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-09-lambda-concurrency-limit-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "claude_md_project_contract", "label": "CLAUDE.md target design (per-project layout)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-11-09-lambda-concurrency-limit-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_11_09_lambda_concurrency_limit_design", "label": "lambda-concurrency-limit design spec (2026-11-09)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-11-09-lambda-concurrency-limit-design.md", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_11_09_lambda_concurrency_limit_design_profiles", "label": "k6 profiles (discovery, constant, spike, noisy-neighbour)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-09-lambda-concurrency-limit-design.md", "rationale": "VU cap of 100 on Grafana Cloud k6 (E2004) forces Little's-law sizing, gracefulStop 0s, and split caps across parallel scenarios.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_11_09_lambda_concurrency_limit_design_per_user_limit", "label": "Per-user limit (knob 1)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-09-lambda-concurrency-limit-design.md", "rationale": "Random arrivals bunch, so a limit barely above the mean refuses many requests unless burst is large; burst = 2 x rate.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_11_09_lambda_concurrency_limit_design_otel", "label": "OpenTelemetry layers and collector", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-09-lambda-concurrency-limit-design.md", "rationale": "deco
{"nodes": [{"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design", "label": "ecs-dynamodb-rps-ceiling design spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d7_k6_sli", "label": "D7: k6 as SLI source (reversed)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reversed because an SLI that only exists during a load test is not a service level indicator, and the CloudWatch datasource/IAM role it avoided already existed.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d10_server_timing", "label": "D10: Server-Timing and event-loop lag instrumentation (reversed)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measurement was published on the service's HTTP surface for the harness's benefit and event-loop lag already flowed via RuntimeNodeInstrumentation; also db_ms inflated 12.1x with DB unchanged.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d5_ratio_sli", "label": "D5: ratio SLI with per-class thresholds", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A percentile cannot compose across heterogeneous endpoints, cannot produce an error budget, and grafana_slo is built on Success/Total so it cannot express a percentile at all.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d1_dynamodb", "label": "D1: DynamoDB chosen over DocumentDB/RDS", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fastest provision/destroy, no NAT, no hourly instance cost, and no burstable CPU credits that would break run-to-run comparability.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d6_provisioned", "label": "D6: PROVISIONED billing mode", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provisioned converts overload into visible throttling rather than bill; the reason is the hard ceiling, not savings.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d9_pbkdf2", "label": "D9: pbkdf2Sync CPU work", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic, allocation-free, no GC noise; blocks the event loop to give a sharp knee.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_capacity_model", "label": "Capacity and cost model (weighted 55/15/25/5 mix)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_slo_class_thresholds", "label": "SLO class-threshold ratio objective (fast/standard/heavy)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_load_profiles", "label": "Load profiles: discovery, constant, stress", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arrival-rate executors are used because VU ramps stop adding RPS exactly when measurement needs it.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_burst_capacity_hazard", "label": "DynamoDB burst capacity hazard and warm-up/drain", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}], "edges": [{"source": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design", "target": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-08-29-ecs-dynamodb-rps-ceiling-design.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_d5_ratio_sli", "target": "docs_superpowers_specs_2026_08_29_ecs_dynamodb_rps_ceiling_design_slo_class_thresholds", "relation": "implements", 
{"nodes": [{"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design", "label": "ecs-dynamodb-rps-ceiling SLI collection design spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_s1_gateway_collector", "label": "S1: one gateway collector for the cluster", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing competes for the app task's 0.25 vCPU and CloudWatch is polled once rather than once per task.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_s2_alloy", "label": "S2: Grafana Alloy as collector", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "prometheus.exporter.cloudwatch embeds YACE with tag-keyed discovery jobs, so Project tag finds resources without ARNs.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_s4_native_histograms", "label": "S4: native histograms via OTel exponential histograms", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "histogram_fraction yields the proportion below a threshold from a single series, so thresholds live only in Grafana.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_s3_no_slo_logic", "label": "S3: no SLO logic in the service", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The service emits a distribution and the objective is applied at query time, so it can change without a deploy.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_s12_remote_execution", "label": "S12: Terraform Cloud workspace moves to remote execution", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HCP workspace variables are only injected in remote execution mode, forced by S11 credentials in env vars.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_s13_s14_window", "label": "S13/S14: 7d SLO window and scaled burn-rate windows", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grafana Cloud Free retains 14 days and the SLO API rejects windows outside 7\u201332 days; burn thresholds derived from 30 days would silently change meaning.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_two_pipelines", "label": "Collector pipelines: OTLP service metrics and CloudWatch via remote_write", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routing YACE's Prometheus output through OTLP and back would add a lossy conversion purely to save a credential (S17).", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design_http_route", "label": "http.route must be published by matchRoute onto the span", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The service runs raw node:http with a hand-written router, so instrumentation-http cannot infer a route template; raw paths would be unbounded cardinality.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_08_30_ecs_dynamodb_rps_ceiling_sli_collection_design", "label": "SLI Collection Design (2026-08-30)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "rationale": "Moves SLI computation into service-emitted native histograms collected by a central Alloy collector, so the error budget accrues continuously without k6.", "_origin": "semantic"}, {"id": "sli_collection_alloy_collector", "label": "Alloy collector (single ECS task, not sidecar)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "s6, s9, s16", "rationale": "Rejects Grafana's sidecar pattern because Fargate CPU limit is per task, so a sidecar would draw from the calibrated pbkdf2 CPU budget and poll CloudWatch once per task.", "_origin": "semantic"}, {"id": "sli_collection_native_histogram_slo", "label": "Native histogram SLO queries (histogram_fraction)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "s7", "rationale": "grafana_slo takes Success and Total queries and derives ratio, budget and burn alerting itself, so the SLI must be computed in Grafana from histograms.", "_origin": "semantic"}, {"id": "sli_collection_slo_window_7d", "label": "SLO window 7d and burn windows 14m/84m", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "s7", "rationale": "Grafana's SLO API refuses windows outside 7-32 days and free-tier retention caps at 14 days, so 7d is the only usable value.", "_origin": "semantic"}, {"id": "sli_collection_slo_yaml_generator", "label": "slo.yaml generator", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "s8", "_origin": "semantic"}, {"id": "sli_collection_alloy_config", "label": "Alloy configuration (two pipelines)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "s16", "_origin": "semantic"}, {"id": "sli_collection_traffic_source_label", "label": "traffic_source label", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "s16, s17.1", "rationale": "Bounded to three values so an arbitrary user-agent cannot become a label value.", "_origin": "semantic"}, {"id": "sli_collection_queue_hazard", "label": "Service cannot see the queue hazard", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md", "source_location": "s11", "rationale": "In-process timing starts once the event loop reaches the request, so queueing past the knee is invisible to the service-side SLI.", "_origin": "semantic"}], "
{"nodes": [{"id": "plan_pool_calibrate_baseline", "label": "Plan: ecs-rds-postgres-pool calibrate and baseline", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "plan_pool_d1_sleep_knob", "label": "D1: heavy route sleep knob", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A CPU-only knob cannot make the pool bind before the database CPU does (load ~2.5 per vCPU at knee); splitting hold into CPU work and pg_sleep makes the ratio tunable.", "_origin": "semantic"}, {"id": "plan_pool_d2_mean_hold", "label": "D2: calibrate on mean hold across mix", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Targeting the heavy statement alone left mean hold at few ms and knee above 1000 rps; knee is pool divided by mean hold.", "_origin": "semantic"}, {"id": "plan_pool_d3_thresholds", "label": "D3: thresholds = 3x unloaded server-side p99", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Breaks the circle where k6 profiles need generated thresholds; 3x leaves room for jitter while pool queueing still crosses it near the knee.", "_origin": "semantic"}, {"id": "plan_pool_d4_oneoff_tasks", "label": "D4: seed and calibrate as in-VPC one-off Fargate tasks", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Laptop runs carry internet RTT in every hold-time sample; a one-off task also avoids flipping seed_on_boot on and off.", "_origin": "semantic"}, {"id": "plan_pool_d5_posts_not_reset", "label": "D5: posts table not reset, size recorded", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "plan_pool_solve_knobs", "label": "solveKnobs (calibrate.js)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "plan_pool_run_oneoff", "label": "run-oneoff.sh", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaced aws ecs wait tasks-stopped (fixed 10-minute limit) with a bounded poll so long seeds do not die with a raw waiter error.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline", "label": "Plan 3: ecs-rds-postgres-pool calibrate and baseline", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task6_report_sleep_ms", "label": "Task 6: wire report_sleep_ms through Terraform", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CPU-bound hold alone puts 5 connections at ~2.5x the 2 vCPUs before the pool of 5 binds, so a separate sleep knob is needed (decision D1).", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task7_first_apply", "label": "Task 7: first apply", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task8_deploy_seed", "label": "Task 8: deploy, seed, first-deploy checks", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task9_calibrate", "label": "Task 9: calibrate on the real instance", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task11_freeze_thresholds", "label": "Task 11: freeze thresholds and generate SLO", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Threshold = 3x unloaded server-side p99 so jitter does not breach it while pool queueing still crosses it near the knee (decision D3).", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task14_discovery", "label": "Task 14: discovery run to find the knee", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task15_baseline", "label": "Task 15: baseline constant and stress at pool 5", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stress must exit 99 first: the red half of the red-green loop proves the assertion can fail before any knob is moved.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task17_teardown", "label": "Task 17: tear down or hand over to plan 4", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task18_calibrator_in_image", "label": "Task 18: make calibrator runnable inside image", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at
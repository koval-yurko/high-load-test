{"nodes": [{"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify", "label": "graffiti to graphify Plan (2026-09-19)", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_gitignore_nesting", "label": "Nested .gitignore re-inclusion for semantic cache", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain graphify-out/ with a negation re-includes nothing because git does not descend into an excluded directory, and it fails silently.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_read_guard", "label": "graphify-read-guard.sh wrapper", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify's hardcoded extension tuple lacks .tf/.tfvars/.yaml/.yml; Terraform is ~40% of code files here so the stock guard stays silent where needed.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_semantic_cache", "label": "Committed graphify semantic cache", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only artifact costing LLM calls to recreate; keyed by content hash so portable across clones.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_hcl_extra", "label": "graphifyy[terraform] extra requirement", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without it 33 of 81 code files contribute nothing, and it warns rather than failing.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify", "label": "Plan: graffiti to graphify migration", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_read_guard", "label": "graphify-read-guard.sh hook wrapper", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "rationale": "graphify's stock guard tests a hardcoded extension tuple lacking .tf/.tfvars/.yaml/.yml; Terraform is ~40% of code files, so a wrapper handles those four and pipes everything else to `graphify hook-guard read` to preserve upstream behavior.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_doc_stale_hook", "label": "graphify-doc-stale.sh SessionStart hook", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "rationale": "graphify's needs_update flag is written only by `graphify watch`; git hooks are AST-only and inert in worktrees, so a find -newer check reports doc-half staleness.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_settings_wiring", "label": "Wire hooks into .claude/settings.json", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "rationale": "Uses $CLAUDE_PROJECT_DIR absolute paths so worktree sessions resolve helper scripts; --strict avoided because it hard-denies first raw Read and the graph never covers everything.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_skill", "label": "graphify project skill (SKILL.md)", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "rationale": "Kept short deliberately; vendoring graphify's 40KB skill would cost context without repo-specific content.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_git_hooks", "label": "graphify git hooks (post-commit, post-checkout)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "rationale": "Rebuild detached in background; exit early in linked worktrees where git-dir differs from git-common-dir.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_ci_workflow", "label": "graphify-semantic-cache.yml CI workflow", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "rationale": "Master only: content-hash filenames make entries conflict-free between files, single-branch ownership makes them conflict-free within one; guarded against empty commits and re-trigger by claude[bot].", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_semantic_cache", "label": "Committed graphify-out/cache/semantic/", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "rationale": "LLM extraction output committed so paid work is shared across clones and replays free.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_docs_update", "label": "CLAUDE.md and README graphify docs", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_remove_graffiti", "label": "Remove graffiti (last task)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "rationale": "Deleted last because graffiti was the control graphify had to beat before the switch.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_inert_guard_finding", "label": "Finding: terraform spend guard inert", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "rationale": "guard-terraform.sh is registered nowhere and settings.local.json uses bypassPermissions, so both documented apply/destroy gates are inactive.", "_origin": "semantic"}, {"id": "guard_terraform_sh_stub", "label": "guard-terraform.sh", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}], "edges": [{"source": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify", "target": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_gitignore_nesting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify", "target": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_read_guard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify", "target": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_semantic_cache", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-09-19-graffiti-to-graphify.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify", "target": "docs_superpowers_plans_2026_09_19_graffiti_to_graphify_
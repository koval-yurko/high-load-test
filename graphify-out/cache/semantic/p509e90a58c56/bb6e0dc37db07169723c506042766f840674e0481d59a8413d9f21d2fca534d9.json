{"nodes": [{"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline", "label": "ecs-rds-postgres-pool Calibration and Baseline Plan (plan 3)", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_d1_sleep_knob", "label": "D1: heavy route gets a timed pg_sleep beside its scan", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A CPU-only knob is CPU-bound end to end (f\u22481), putting 5 connections at ~2.5x the 2 vCPUs before the pool of 5 binds; splitting the hold into CPU work plus a timed wait makes the CPU fraction solvable. Metric for headroom changes from DBLoadRelativeToNumVCPUs to DBLoadCPU/vCPUs because pg_sleep sessions count as active.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_d2_mean_hold", "label": "D2: calibrate against mean hold across the mix", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan 1 aimed 20 ms at the heavy statement alone, but reports are 1 in 20 requests, so the mean hold would be a few ms and the knee above 1000 rps; the 250 rps comes from pool \u00f7 mean hold.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_d3_thresholds", "label": "D3: class thresholds = 3x unloaded server-side p99", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three times leaves room for jitter and the heartbeat at low load, while pool queueing still crosses it near the knee. Read server-side because the SLI is server-side. Pool connection timeout follows as heavy + 100 ms.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_d4_oneoff_tasks", "label": "D4: seed and calibrate as in-VPC one-off Fargate tasks", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hold time measured over the public internet would carry tens of ms of RTT against a 20 ms target; one-off tasks also avoid a seed_on_boot flip-flop second apply.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_d5_posts_not_reset", "label": "D5: posts table not reset; its size is recorded", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "20% of the mix inserts and the heartbeat inserts every minute, so the table grows regardless; each results.md row records SELECT count(*) FROM posts instead (ruling R20 of plan 2).", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task_3_sleep_knob", "label": "Task 3: sleep knob in the heavy route (REPORT_SLEEP_MS)", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task_4_solveknobs", "label": "Task 4: calibrator solveKnobs from the mix", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task_5_run_oneoff", "label": "Task 5: run-oneoff.sh one-off task runner", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The ecs wait tasks-stopped waiter is fixed at ten minutes, so the script was amended to poll describe-tasks with a WAIT_SECONDS ceiling and propagate the container exit code.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task_7_first_apply", "label": "Task 7: first apply gate", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task_9_calibrate", "label": "Task 9: calibrate on the real instance", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task_11_freeze_thresholds", "label": "Task 11: freeze thresholds and generate derived artifacts", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task_14_discovery", "label": "Task 14: discovery run, find the knee", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task_15_baseline", "label": "Task 15: baseline constant and stress at pool 5", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task_18_calibrator_in_image", "label": "Task 18: make the calibrator runnable inside the image (CAPACITY_MIX / readMix)", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-24-ecs-rds-postgres-pool-calibrate-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "slo.yaml is outside the Docker context and yaml is a devDependency omitted by npm ci --omit=dev, so the container could not parse it; the mix is passed in as CAPACITY_MIX JSON.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_24_ecs_rds_postgres_pool_calibrate_baseline_task_20_readme_runbook", "label": "Task
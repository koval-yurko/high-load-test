    {
      "id": 18,
      "type": "row",
      "title": "6. Service SLI — as the alert rules compute it",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 46
      },
      "panels": []
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "SLI ratio: proportion meeting per-class threshold",
      "description": "The same ratio grafana_slo.latency_classes and the burn-rate alert rules read (grafana/locals.tf class_ratio_query), differing only in $__rate_interval — this is what pages, not a proxy for it.",

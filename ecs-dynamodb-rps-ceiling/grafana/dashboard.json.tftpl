          },
          "namespace": "AWS/ApplicationELB",
          "metricName": "HealthyHostCount",
          "statistic": "Average",
          "dimensions": {
            "TargetGroup": "targetgroup/ecs-dynamodb-rps-ceiling/901238716f26dd35",

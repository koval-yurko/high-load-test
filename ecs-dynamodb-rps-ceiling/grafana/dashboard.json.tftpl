          },
          "namespace": "AWS/DynamoDB",
          "metricName": "ConsumedReadCapacityUnits",
          "statistic": "Sum",
          "dimensions": {
            "TableName": "$table_name"
          },
          "region": "eu-central-1",
          "period": "60",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true
        },
        {
          "refId": "B",

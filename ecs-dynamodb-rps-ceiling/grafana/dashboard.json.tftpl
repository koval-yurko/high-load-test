          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "5. Edge (ALB) \u2014 confirm load actually arrived as intended",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "ALB RequestCount",
      "description": "Requests actually reaching the target group per period. Compare against k6's arrival rate to confirm the offered load and the delivered load match \u2014 a gap means requests k6 intended to send never reached the ALB. Read it beside the latency panels before calling that an upstream limit: k6's arrival-rate executor also drops iterations when its pre-allocated VUs are exhausted, which happens when responses are slow, so a slow app produces this gap too.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch_datasource_uid}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch_datasource_uid}"
          },
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "statistic": "Sum",
          "dimensions": {
            "LoadBalancer": "app/ecs-dynamodb-rps-ceiling/ac6391a947d04ee8"
          },
          "region": "eu-central-1",
          "period": "60",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "ALB TargetResponseTime (p95, Average, Maximum)",
      "description": "Edge-measured response time, independent of anything the service reports about itself. p95 via the CloudWatch extended statistic where supported; Average and Maximum are always included as a fallback and to show tail spread.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch_datasource_uid}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch_datasource_uid}"
          },
          "namespace": "AWS/ApplicationELB",
          "metricName": "TargetResponseTime",
          "statistic": "p95",
          "dimensions": {
            "LoadBalancer": "app/ecs-dynamodb-rps-ceiling/ac6391a947d04ee8"
          },
          "region": "eu-central-1",
          "period": "60",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch_datasource_uid}"
          },
          "namespace": "AWS/ApplicationELB",
          "metricName": "TargetResponseTime",
          "statistic": "Average",
          "dimensions": {
            "LoadBalancer": "app/ecs-dynamodb-rps-ceiling/ac6391a947d04ee8"
          },
          "region": "eu-central-1",
          "period": "60",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch_datasource_uid}"
          },
          "namespace": "AWS/ApplicationELB",
          "metricName": "TargetResponseTime",
          "statistic": "Maximum",
          "dimensions": {
            "LoadBalancer": "app/ecs-dynamodb-rps-ceiling/ac6391a947d04ee8"
          },
          "region": "eu-central-1",
          "period": "60",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
            "spanNulls": true
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "HTTP status codes (2XX / 4XX / 5XX)",
      "description": "5XX rising is the app or its dependencies failing outright, not just slowing down \u2014 a distinct failure mode from throttling or latency. 4XX at the target vs. at the ELB itself separates application-level rejections from load-balancer-level ones (e.g. malformed requests never reaching a task).",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch_datasource_uid}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch_datasource_uid}"
          },
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_Target_2XX_Count",
          "statistic": "Sum",
          "dimensions": {
            "LoadBalancer": "app/ecs-dynamodb-rps-ceiling/ac6391a947d04ee8"
          },
          "region": "eu-central-1",

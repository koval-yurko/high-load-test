          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "ECS LiveTaskCount",
      "description": "Task count over time. Currently pinned at 1; once autoscaling is enabled this is the panel that shows 1->4 actually happening under load, not just being configured.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch_datasource_uid}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch_datasource_uid}"
          },
          "namespace": "AWS/ECS",
          "metricName": "LiveTaskCount",
          "statistic": "Average",
          "dimensions": {
            "ClusterName": "ecs-dynamodb-rps-ceiling",
            "ServiceName": "ecs-dynamodb-rps-ceiling"
          },
          "region": "eu-central-1",
          "period": "60",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true
        }
      ],
      "fieldConfig": {
        "defaults": {

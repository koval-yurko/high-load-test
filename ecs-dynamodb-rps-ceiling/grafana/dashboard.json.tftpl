    {
      "id": 17,
      "type": "timeseries",
      "title": "ALB HealthyHostCount",
      "description": "Healthy targets in the target group. A drop here during a run means tasks are failing health checks under load. That is not by itself a service-side ceiling: on 2026-09-01, AWS SDK retry backoff on a throttled DynamoDB call pinned event-loop utilisation at 1.000 with CPU at 3\u201316%, and a task whose event loop is saturated fails its health check too. Read it beside the throttle-events panel.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch_datasource_uid}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",

    {
      "id": 14,
      "type": "timeseries",
      "title": "ALB RequestCount",
      "description": "Requests actually reaching the target group per period. Compare against k6's arrival rate to confirm the offered load and the delivered load match \u2014 a gap here means the ceiling is upstream of the app entirely (connection limits, DNS, the load generator).",
      "datasource": {
        "type": "cloudwatch",
        "uid": "a4139e7c-dc84-47c8-b90b-d710ec0fe3fb"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 38
      },

          },
          "region": "eu-central-1",
          "period": "60",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "a4139e7c-dc84-47c8-b90b-d710ec0fe3fb"
          },
          "namespace": "AWS/ApplicationELB",
          "metricName": "TargetResponseTime",
          "statistic": "Average",
          "dimensions": {
            "LoadBalancer": "app/ecs-dynamodb-rps-ceiling/ac6391a947d04ee8"
          },
          "region": "eu-central-1",
          "period": "60",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true

// GENERATED into ALLOY_CONFIG_CONTENT by Terraform. Do not edit in the console.
// Spec: docs/superpowers/specs/2026-08-30-ecs-dynamodb-rps-ceiling-sli-collection-design.md section 16

// === Pipeline 1: service metrics. OTLP in, OTLP out, exponential histograms
// === pass through unconverted and land in Mimir as native histograms.
otelcol.receiver.otlp "app" {
  http { endpoint = "0.0.0.0:4318" }
  grpc { endpoint = "0.0.0.0:4317" }
  output { metrics = [otelcol.processor.transform.classify.input] }
}

otelcol.processor.transform "classify" {
  error_mode = "ignore"

  metric_statements {
    context = "datapoint"
    statements = [
${class_statements}
      // NO traffic_source rules here. They used to live in this block, keyed on
      // attributes["user_agent.original"] -- an attribute the service never
      // records, so neither override could ever match and the unconditional
      // default pinned every datapoint at "other". Worse, that default would now
      // CLOBBER the value the service does set. The label is produced by
      // trafficSource() in src/otel.js, where it can be bounded before it ever
      // reaches the histogram.
    ]
  }

  output { metrics = [otelcol.processor.batch.default.input] }
}

otelcol.processor.batch "default" {
  output { metrics = [otelcol.exporter.otlphttp.grafana_cloud.input] }
}

otelcol.auth.basic "grafana_cloud_otlp" {
  username = sys.env("OTLP_USERNAME")
  password = sys.env("OTLP_PASSWORD")
}

otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    endpoint = sys.env("OTLP_ENDPOINT")
    auth     = otelcol.auth.basic.grafana_cloud_otlp.handler
  }
}

// === Pipeline 2: AWS metrics, discovered by the Project tag. One collector for
// === the cluster, so this polls once rather than once per app task.
// CloudWatch publishes with lag, so polling only the newest 60s period returns
// empty recent windows that look like an outage during a load test. `delay` is
// how YACE handles that -- but Alloy v1.10.0's prometheus.exporter.cloudwatch
// does NOT expose it, on `discovery`, on `metric`, or at the exporter root
// (verified with `alloy validate` out of grafana/alloy:v1.10.0 itself). The lag
// is absorbed instead by `length` being 5x `period`: each poll asks for a 300s
// window and takes the newest datapoint CloudWatch has actually published.
// period/length are per-METRIC attributes here, not per-discovery.
prometheus.exporter.cloudwatch "aws" {
  sts_region = "${region}"

  discovery {
    type        = "AWS/DynamoDB"
    regions     = ["${region}"]
    search_tags = { "Project" = "${project}" }

    metric {
      name       = "ThrottledRequests"
      statistics = ["Sum"]
      period     = "60s"
      length     = "300s"
    }
    metric {
      name       = "ReadThrottleEvents"
      statistics = ["Sum"]
      period     = "60s"
      length     = "300s"
    }
    metric {
      name       = "WriteThrottleEvents"
      statistics = ["Sum"]
      period     = "60s"
      length     = "300s"
    }
    metric {
      name       = "ConsumedReadCapacityUnits"
      statistics = ["Sum"]
      period     = "60s"
      length     = "300s"
    }
    metric {
      name       = "ConsumedWriteCapacityUnits"
      statistics = ["Sum"]
      period     = "60s"
      length     = "300s"
    }
    metric {
      name       = "SuccessfulRequestLatency"
      statistics = ["Average", "Maximum"]
      period     = "60s"
      length     = "300s"
    }
  }

  discovery {
    type        = "AWS/ApplicationELB"
    regions     = ["${region}"]
    search_tags = { "Project" = "${project}" }

    metric {
      name       = "RequestCount"
      statistics = ["Sum"]
      period     = "60s"
      length     = "300s"
    }
    metric {
      name       = "TargetResponseTime"
      statistics = ["Average", "Maximum", "p95"]
      period     = "60s"
      length     = "300s"
    }
    metric {
      name       = "HTTPCode_Target_5XX_Count"
      statistics = ["Sum"]
      period     = "60s"
      length     = "300s"
    }
  }

  discovery {
    type        = "AWS/ECS"
    regions     = ["${region}"]
    search_tags = { "Project" = "${project}" }

    metric {
      name       = "CPUUtilization"
      statistics = ["Average", "Maximum"]
      period     = "60s"
      length     = "300s"
    }
    metric {
      name       = "MemoryUtilization"
      statistics = ["Average", "Maximum"]
      period     = "60s"
      length     = "300s"
    }
  }
}

prometheus.scrape "cloudwatch" {
  targets         = prometheus.exporter.cloudwatch.aws.targets
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = "60s"
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("PROM_URL")
    basic_auth {
      username = sys.env("PROM_USERNAME")
      password = sys.env("PROM_PASSWORD")
    }
  }
}

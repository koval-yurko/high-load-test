{
  "title": "ecs-dynamodb-rps-ceiling \u2014 attribution",
  "description": "Live attribution dashboard: which resource is the RPS ceiling during a k6 run \u2014 DynamoDB, the ECS task, or the edge. Read top-to-bottom while a run is in flight.",
  "tags": [
    "ecs-dynamodb-rps-ceiling"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "table_name",
        "type": "textbox",
        "label": "DynamoDB table",
        "description": "Table name used in every DynamoDB CloudWatch dimension on this dashboard.",
        "query": "ecs-dynamodb-rps-ceiling",
        "current": {
          "text": "ecs-dynamodb-rps-ceiling",
          "value": "ecs-dynamodb-rps-ceiling"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "1. Attribution \u2014 which resource is the ceiling?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []

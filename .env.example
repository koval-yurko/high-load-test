# ============================================================================
# GLOBAL SECRETS — copy to .env and fill in.  .env is gitignored; never commit it.
#   Load with:  set -a && source .env && set +a
# Per-project, non-secret settings live in <project>/.env and <project>/*.tfvars.
# ============================================================================

# --- AWS -------------------------------------------------------------------
# Permanent IAM user keys, defined once here. The AWS CLI, SDKs and the
# Terraform AWS provider all read these environment variables FIRST — ahead of
# ~/.aws/credentials — so no named profile is needed for this repo.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# Guard rail. This machine has a [default] profile, so a shell where .env was
# never loaded does NOT fail — it silently uses that other account. Pin the
# account these projects belong to; /env refuses to provision if the caller
# identity does not match.
AWS_ACCOUNT_ID=

# Leave AWS_PROFILE UNSET. Setting it alongside the keys above makes which
# credentials win depend on the tool. .envrc unsets it for this directory.

# --- Terraform Cloud -------------------------------------------------------
# The variable name encodes the hostname with dots replaced by underscores.
# For app.terraform.io it must be spelled exactly TF_TOKEN_app_terraform_io.
# Create at: https://app.terraform.io/app/settings/tokens
TF_TOKEN_app_terraform_io=
TF_CLOUD_ORGANIZATION=

# versions.tf declares a bare `cloud {}` so nothing environment-specific is
# committed — which means the project and workspace MUST come from here.
# TF_CLOUD_PROJECT takes the project NAME (not the prj-... id). Every workspace
# in this repo belongs to it; without it `terraform init` silently creates the
# workspace in the organization's default project instead.
TF_CLOUD_PROJECT=high-load-test
# One workspace per project directory, named for it (CLAUDE.md). Set it per
# project when running Terraform, e.g. TF_WORKSPACE=ecs-dynamodb-rps-ceiling.
TF_WORKSPACE=

# --- Grafana Cloud (Terraform provider: dashboards, alert rules, SLOs) ------
# GRAFANA_URL is your stack URL, e.g. https://<stack>.grafana.net
# GRAFANA_AUTH is a service-account token with Editor/Admin on that stack.
GRAFANA_URL=
GRAFANA_AUTH=

# --- Grafana Cloud OTLP gateway (the collector's metrics egress) ------------
# Distinct from K6_PROMETHEUS_RW_* below: different endpoint, and a DIFFERENT
# instance ID. Do not "fix" one to match the other.
#
# ENDPOINT  ends in /otlp (the collector appends /v1/metrics itself).
# USERNAME  is the numeric Instance ID from the portal's OpenTelemetry tile --
#           NOT the access policy's name. Verified 2026-08-30: the ID returns
#           HTTP 200, the policy name returns 401 invalid credentials.
# PASSWORD  is the access policy token (glc_...). Scope it to metrics:write
#           ONLY -- it reaches the ECS task definition as a plain environment
#           variable, readable by anyone holding ecs:DescribeTaskDefinition.
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_USERNAME=
GRAFANA_OTLP_PASSWORD=

# Needed only for grafana_cloud_* resources (managing the stack itself).
#GRAFANA_CLOUD_ACCESS_POLICY_TOKEN=

# --- Grafana Cloud k6 (running tests in the cloud: k6 cloud run) -----------
K6_CLOUD_TOKEN=
K6_CLOUD_PROJECT_ID=

# --- Streaming local k6 runs into Grafana Cloud Prometheus ------------------
# Used by:  k6 run -o experimental-prometheus-rw ...
# URL ends in /api/prom/push ; username is the numeric Prometheus instance ID.
K6_PROMETHEUS_RW_SERVER_URL=
K6_PROMETHEUS_RW_USERNAME=
K6_PROMETHEUS_RW_PASSWORD=
K6_PROMETHEUS_RW_TREND_STATS=p(95),p(99),min,max

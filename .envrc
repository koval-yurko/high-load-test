# direnv: loads .env automatically on entering this directory.
#   brew install direnv
#   echo 'eval "$(direnv hook zsh)"' >> ~/.zshrc && exec zsh
#   direnv allow       # run once here, and again after each .env change
dotenv_if_exists .env

# This machine has ~/.aws profiles including [default]. Unset AWS_PROFILE so it
# can never take precedence over, or conflict with, the keys from .env.
unset AWS_PROFILE
unset AWS_DEFAULT_PROFILE

# Fail loudly rather than silently falling back to the [default] profile.
if [ -z "${AWS_ACCESS_KEY_ID:-}" ]; then
  echo "WARNING: AWS_ACCESS_KEY_ID not set — copy .env.example to .env and fill it in." >&2
fi

// Forked from ecs-dynamodb-rps/infra/grafana/alloy.alloy.tftpl on 2026-09-21.
// A bug fixed here does not reach the sibling copy; fix both.

// GENERATED into ALLOY_CONFIG_CONTENT by Terraform. Do not edit in the console.

// === Pipeline 1: service metrics. OTLP in, OTLP out, exponential histograms
// === pass through unconverted and land in Mimir as native histograms.
otelcol.receiver.otlp "app" {
  http { endpoint = "0.0.0.0:4318" }
  grpc { endpoint = "0.0.0.0:4317" }
  output { metrics = [otelcol.processor.transform.classify.input] }
}

otelcol.processor.transform "classify" {
  error_mode = "ignore"

  metric_statements {
    context = "datapoint"
    statements = [
${class_statements}
      // NO traffic_source rules here. They used to live in this block, keyed on
      // attributes["user_agent.original"] -- an attribute the service never
      // records, so neither override could ever match and the unconditional
      // default pinned every datapoint at "other". Worse, that default would now
      // CLOBBER the value the service does set. The label is produced by
      // trafficSource() in src/otel.js, where it can be bounded before it ever
      // reaches the histogram.
    ]
  }

  output { metrics = [otelcol.processor.batch.default.input] }
}

otelcol.processor.batch "default" {
  output { metrics = [otelcol.exporter.otlphttp.grafana_cloud.input] }
}

otelcol.auth.basic "grafana_cloud_otlp" {
  username = sys.env("OTLP_USERNAME")
  password = sys.env("OTLP_PASSWORD")
}

otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    endpoint = sys.env("OTLP_ENDPOINT")
    auth     = otelcol.auth.basic.grafana_cloud_otlp.handler
  }
}

// Pipeline 2 -- a prometheus.exporter.cloudwatch scraping DynamoDB's
// SuccessfulRequestLatency -- is deliberately absent. It existed to subtract the
// datastore's own server-side clock from the service's db histogram. Postgres
// publishes no per-operation server-side latency, so there is nothing to
// subtract; queue depth is measured directly instead, as db.pool.wait.duration
// per class. Dropping it also removes the tag:GetResources grant and the
// per-minute GetMetricData charge.
